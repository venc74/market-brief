    {% for x in qm_ep.not_neglected %}<span style="font-family:'IBM Plex Mono',monospace;color:var(--text)">{{ x.ticker }} +{{ "%.1f"|format(x.gap_pct) }}%</span> ({{ x.why }}){{ "; " if not loop.last else "" }}{% endfor %}</div>
