      <td>{{ gw_st.get(p.status or p.resolution, p.status or p.resolution) }}{% if p.status == "open" and p.dist_to_line_pct is number %} <span class="cs-mu">· до линията {{ "%+.1f"|format(p.dist_to_line_pct) }}%</span>{% elif p.resolution_date %} <span class="cs-mu">· {{ p.resolution_date[8:10] }}.{{ p.resolution_date[5:7] }}</span>{% endif %}{% if p.needs_review %} <span class="cs-warn">· ръчен преглед</span>{% endif %}</td>
      <td class="num">{{ p.hold_sessions if p.hold_sessions is not none else "—" }}</td>
