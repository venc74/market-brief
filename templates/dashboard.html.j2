      {% endif %}
      <div class="glb-note">{{ g.risk_note }}</div>
      {% if g.in_screener %}<div class="si-flag">✓ и в нашия скрийнър — конвергенция</div>{% endif %}
      {% if g.already_open_position %}<div class="si-flag">📈 OPEN — вече отворена Track Record позиция</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% if glb_momentum %}
  <div class="glb-group-label momentum">Momentum GLB ({{ glb_momentum|length }})</div>
  <div class="glb-grid">
    {% for g in glb_momentum %}
    <div class="glb-card momentum{{ ' in-screen' if g.in_screener else '' }}">
      <div class="glb-top">
        <span class="glb-sym">{{ g.ticker }}</span>
        <span class="glb-price">${{ "%.2f"|format(g.price) }}</span>
      </div>
      {% if g.company and g.company != g.ticker %}<div class="glb-company">{{ g.company[:40] }}</div>{% endif %}
      <div class="glb-stat">{{ g.months_unpenetrated }} месеца unpenetrated</div>
      <div class="glb-detail">prior high ${{ "%.2f"|format(g.prior_high) }} ({{ g.prior_high_month }})</div>
      {% if g.tightness %}
      <div class="glb-detail">band_hold {{ g.tightness.band_hold_pct }}% · tightness ±{{ g.tightness.tightness_range_pct }}%</div>
      {% endif %}
      {% if g.ath_label == 'new_high_since_listing' %}
      <div class="glb-caveat">⚠ по-кратка налична история — "нов връх откакто имаме данни", не потвърден буквален all-time high</div>
      {% endif %}
      <div class="glb-note">{{ g.risk_note }}</div>
      {% if g.in_screener %}<div class="si-flag">✓ и в нашия скрийнър — конвергенция</div>{% endif %}
      {% if g.already_open_position %}<div class="si-flag">📈 OPEN — вече отворена Track Record позиция</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% if glb_insufficient %}
  <div class="glb-insufficient-note">
    Недостатъчна дневна история за tightness оценка (валиден месечен GLB сигнал, но некласифициран Classic/Momentum):
    {{ glb_insufficient|map(attribute='ticker')|join(', ') }}
  </div>
  {% endif %}
</section>
{% endif %}

