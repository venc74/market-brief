      {% if st.setup and not st.setup.triggered and st.ai.watchlist_reason_type != 'technical_gate' and st.setup.trigger_text not in (st.ai.watchlist_trigger or '') %}
      <div class="watch-trigger"><b>Сетъп:</b> {{ st.setup.trigger_text }}</div>
