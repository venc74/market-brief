      </div>
      <div class="block">
        <h3>Техническа картина</h3>
        <div class="kv"><span>База (13 седмици)</span><b>{{ st.base_type }}</b></div>
        <div class="kv"><span>Weinstein Stage</span><b>{{ st.weinstein_stage }}</b></div>
        <div class="kv"><span>RS Line</span><b>{{ "нов максимум" if st.rs_status == "new_high" else "близо до максимум" }}</b></div>
        {# FIX 2026-10-03 (пакет 1, т.9): RS rating = перцентил на претеглената 12-месечна доходност в универса #}
        {% if st.rs_rating is not none and st.rs_rating is defined %}<div class="kv"><span>RS rating (перцентил)</span><b>{{ st.rs_rating }}</b></div>{% endif %}
        {% if st.pct_above_52w_low is defined %}<div class="kv"><span>52-седмичен диапазон</span><b>+{{ st.pct_above_52w_low }}% над дъното · −{{ st.pct_below_52w_high }}% под върха</b></div>{% endif %}
        <div class="kv"><span>50DMA / 200DMA</span><b>${{ st.ma50 }} / ${{ st.ma200 }}</b></div>
        <div class="kv"><span>Обем (vs 50d avg)</span><b>{{ st.volume_ratio }}x{{ " ✓ пробивен" if st.breakout_volume else "" }}</b></div>
        {% if st.entry_timing %}
        <div class="kv"><span>Entry Timing</span>
          <b style="color: {{ 'var(--green)' if st.entry_timing.verdict == 'good' else 'var(--red)' if st.entry_timing.verdict == 'wait' else 'var(--yellow)' }}">
            {{ 'Добър timing' if st.entry_timing.verdict == 'good' else 'Изчакай' if st.entry_timing.verdict == 'wait' else 'Внимание' }}
          </b>
