        {% if st.ai.earnings_call %}<div class="kv"><span title="Текстът е на модела, не е препоръка; датата и предупреждението за отчета горе са от кода">Бележка на AI за отчета</span><b>{{ st.ai.earnings_call }}</b></div>{% endif %}
