            · замразена от {{ p.needs_manual_review.frozen_days }} дни{% endif %}
          </td>
          {% else %}
          <td class="n pct">{% if p.unrealized_pct is not none %}{{ '+' if p.unrealized_pct >= 0 else '' }}{{ p.unrealized_pct }}%{% else %}—{% endif %}</td>
          {% endif %}
          <td class="n pct">{% if p.spy_return_pct is defined and p.spy_return_pct is not none %}{{ "%+.1f"|format(p.spy_return_pct) }}%{% else %}—{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% for p in backtest.open_positions[:100] %}
  {{ earnings_modal("earn-modal-track-" ~ p.ticker ~ "-" ~ p.entry_date, p.earnings_recap) }}
  {% endfor %}
  {% if backtest.open_positions|length > 100 %}
  <div class="small" style="font-size:12px;color:var(--muted);margin-top:8px">
    и още {{ backtest.open_positions|length - 100 }} позиции
  </div>
  {% endif %}
  {% endif %}
  </details>
</section>
{% endif %}

{# Пакет 1б (05.10): buy-stop кандидатите (Watchlist) — ОТДЕЛНА книга, измерване, не препоръка; не е позиция и не се слива с Action #}
{% if backtest and backtest.buystop and backtest.buystop.enabled %}
{% set bs = backtest.buystop %}
{% set bs_res = {"stopped": "стоп", "trailing_stop_exit": "trailing изход", "expired": "изтекла по време", "expired_in_trail": "изтекла в trail"} %}
{% set bs_st = {"pending": "чака buy-stop", "open": "отворена", "trailing": "след цел 1 (trailing)"} %}
<section>
  <details class="canslim-book">
  <summary>
  <h2>Buy-stop кандидати — измерване, не препоръка</h2>
  <span class="book-hint">книга buy-stop · записани {{ bs.records if bs.records is defined else "—" }} — разгъни</span>
  </summary>
  <div class="small" style="font-size:12.5px;color:var(--muted);margin:0 0 8px">
    Watchlist карти под pivot с buy-stop, следени със същия модел на изпълнение като Action (вход при High ≥ buy-stop в рамките на
    {{ buy_stop_window }} сесии, по max(Open, buy-stop), не над +{{ buyable_zone_pct|round(0)|int }}%; стоп и цел от картата) във всички режими.
    Отделна книга: един и същ тикър може да е и в двете (отметка „и Action“), статистиките не се сумират. Не са позиции и не са съвет за покупка.</div>
  <div class="prose">
    {% if not bs.records %}
    <b>Още няма записани кандидати</b> — записват се Watchlist карти с buy-stop и валиден план.<br>
    {% else %}
    <b>Записани: {{ bs.records }}</b> · чакат buy-stop {{ bs.pending }} · отворени {{ bs.open }} · затворени {{ bs.closed }}
    · не се задействаха {{ bs.not_triggered }}{% if bs.not_triggered_pct is not none %} ({{ bs.not_triggered_pct }}% от приключилите прозорци){% endif %}{% if bs.skipped %}
    · над тавана за вход {{ bs.skipped }}{% endif %}{% if bs.also_action %} · и в Action: {{ bs.also_action }}{% endif %}<br>
    {% if bs.needs_review %}<span style="color:var(--yellow)">⚠ {{ bs.needs_review }} запис(а) с отделяне след входа — не се коригират като сплит, нужен е ръчен преглед.</span><br>{% endif %}
    {% if bs.closed %}Затворени: {{ bs.closed }} · среден R: {{ "%+.2f"|format(bs.avg_realized_r) }}<br>{% endif %}
    {% if bs.stats_visible %}
    <b>Win rate: {{ bs.win_rate_pct }}%</b> ({{ bs.wins }} win / {{ bs.losses }} loss; 95% интервал {{ bs.win_ci_pct[0] }}–{{ bs.win_ci_pct[1] }}%)
    · медиана R {{ "%+.2f"|format(bs.median_realized_r) }}<br>
    {% if bs.spy_compare %}Спрямо SPY (същите периоди, {{ bs.spy_compare.n }} затворени): средно {{ "%+.2f"|format(bs.spy_compare.avg_return_pct) }}%
    срещу SPY {{ "%+.2f"|format(bs.spy_compare.avg_spy_pct) }}% → разлика {{ "%+.2f"|format(bs.spy_compare.avg_alpha_pct) }}%<br>{% endif %}
    {% else %}
    Win rate се показва след {{ bs.min_closed }} затворени (сега {{ bs.closed }}) — при по-малко е шум.<br>
    {% endif %}
    По режим на деня на картата (записани / затворени{% if bs.stats_visible %}, среден R{% endif %}):
    {% for name, g in bs.by_regime.items() %}{{ name }} {{ g.records }} / {{ g.closed }}{% if bs.stats_visible and g.avg_r is not none %} ({{ "%+.2f"|format(g.avg_r) }}R){% endif %}{{ " · " if not loop.last else "" }}{% endfor %}
    {% endif %}
  </div>
  {{ entry_vol_line(bs.entry_volume) }}
  {{ events_line(bs.events, "R") }}
  {% if bs.live %}
  <div class="small" style="font-size:12px;color:var(--muted);margin-top:14px">Чакащи и отворени ({{ bs.live|length }}):</div>
  <div class="card" style="padding:6px 4px;margin-top:6px">
    <table class="pos-table">
      <thead><tr><th>Тикър</th><th>Карта от</th><th>Статус</th><th class="n">Buy-stop</th><th class="n">Стоп</th><th class="n">Цел 1</th>
        <th>Валиден до</th><th>Режим</th></tr></thead>
      <tbody>
        {% for p in bs.live %}
        <tr><td class="sym">{{ p.ticker }}{% if p.also_action %}{{ markers_html([{"tag": "и Action", "title": "Тикърът е и в Action книгата в застъпващ се период — две независими книги, статистиките не се сумират."}]) }}{% endif %}{{ markers_html(p.markers) }}{{ spinoff_note_html(p) }}</td>
          <td>{{ p.entry_date }}</td>
          <td>{{ bs_st.get(p.status, p.status) }}{% if p.fill_date %} от {{ p.fill_date }}{% endif %}{% if p.current_r is not none %} · {{ "%+.1f"|format(p.current_r) }}R{% endif %}{% if p.entry_volume_ratio is defined and p.entry_volume_ratio is not none %} · обем при входа {{ "%.2f"|format(p.entry_volume_ratio) }}×{% endif %}
            {% if p.screener_exit %}<div style="font-size:11.5px;color:var(--yellow)">излезе от скрийнъра: {{ p.screener_exit }}</div>{% endif %}</td>
          <td class="n">${{ p.buy_stop }}</td><td class="n">${{ p.stop_loss }}</td><td class="n">${{ p.target_1 }}</td>
          <td>{{ p.valid_through or "—" }}</td><td>{{ p.regime or "н/д" }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
  {% if bs.recent %}
  <div class="small" style="font-size:12px;color:var(--muted);margin-top:14px">Последни затворени ({% if bs.closed and bs.closed > bs.recent|length %}последните {{ bs.recent|length }} от {{ bs.closed }}{% else %}{{ bs.recent|length }}{% endif %}):</div>
  <div class="watch-grid" style="margin-top:6px">
    {% for r in bs.recent %}
    <div class="watch-card">
      <span class="ticker" style="color: {{ 'var(--green)' if r.realized_r and r.realized_r > 0 else 'var(--red)' }}">{{ r.ticker }}</span>{% if r.also_action %}{{ markers_html([{"tag": "и Action", "title": "Тикърът е и в Action книгата в застъпващ се период."}]) }}{% endif %}
      <p>{{ r.entry_date }} → {{ r.resolution_date }} · {{ bs_res.get(r.resolution, r.resolution) }} · R={{ r.realized_r }} · {{ r.regime or "н/д" }}</p>
    </div>
    {% endfor %}
  </div>
  {% endif %}
  </details>
</section>
{% endif %}

{# Qullamaggie (07.10.2026): ДВЕ секции след Watchlist (от 19.10 — след сгънатите книги на CANSLIM) и преди GLB — "Пробиви по Kullamägi (Breakout)" и "Епизодични пивоти (EP) · гапове след новина".
   ОТДЕЛНА стратегия (механичен скенер без AI, наблюдение на EP, собствена книга qm_breakout) — не е Action/Watchlist и не пипа размера на позициите ни; QM✓ върху нашите карти води тук #}
{% set qb = backtest.qm_breakout if backtest and backtest.qm_breakout else none %}
{% set our_qm = (action + watchlist)|map(attribute='ticker')|list %}
{% if qm_cards or qm_diag or (qb and qb.enabled) %}
<section id="qm">
  <h2>Пробиви по Kullamägi (Breakout)</h2>
  <div class="qm-banner">
    <b>Измерване, не препоръка. Реплеят е с survivorship (днешният универс) и резултатът зависи от малко големи печалби. Алфата не е статистически значима.</b>
    {% if qm_replay %}Реплей {{ qm_replay.period }} ({{ qm_replay.trades }} сделки), R = печалба ÷ max(вход − дъното на деня, {{ qm_r_floor }}×ADR): среден R {{ "%+.2f"|format(qm_replay.avg_r) }} [{{ "%+.2f"|format(qm_replay.avg_r_ci[0]) }}; {{ "%+.2f"|format(qm_replay.avg_r_ci[1]) }}] (pess {{ "%+.2f"|format(qm_replay.avg_r_pess) }}),
    доходност на сделка средно {{ "%+.2f"|format(qm_replay.avg_return_pct) }}% (медиана {{ "%+.2f"|format(qm_replay.median_return_pct) }}%), алфа спрямо SPY {{ "%+.2f"|format(qm_replay.alpha_pct) }}% [{{ "%+.2f"|format(qm_replay.alpha_ci[0]) }}; {{ "%+.2f"|format(qm_replay.alpha_ci[1]) }}].
    Досегашният среден R ({{ "%+.2f"|format(qm_replay.old_avg_r) }}) беше раздут от сделки с нищожен риск: {{ qm_replay.floored_trades }} сделки носеха {{ qm_replay.floored_share_of_sum_r_pct }}% от ΣR.{% endif %}
    Отделна стратегия, механичен скенер (без AI), независим от CANSLIM скрийнъра, GLB и от Action/Watchlist; не влиза в Action и не променя размера на позициите ни.
    <b>Входът е по opening range high в сесията, стопът — low of day; брифът дава нивата, не самия вход.</b>
  </div>
  {# 03.11.2026 (разходката, т. 11, 2): пазарът по неговото правило — QQQ спрямо SMA10 / SMA20 по последното затваряне; само информация, не филтър #}
  {% if qm_market_line %}<div class="small" style="font-size:12.5px;margin:4px 0 8px;color:{{ 'var(--green)' if qm_market.above10 and qm_market.above20 else ('var(--red)' if not qm_market.above10 and not qm_market.above20 else 'var(--yellow)') }}"><b>{{ qm_market_line }}</b>
    <span style="color:var(--muted)">· QQQ ${{ "%.2f"|format(qm_market.close) }} на {{ qm_market.date[8:10] }}.{{ qm_market.date[5:7] }}, SMA10 ${{ "%.2f"|format(qm_market.sma10) }}, SMA20 ${{ "%.2f"|format(qm_market.sma20) }} — само информация, не филтър</span></div>{% endif %}
  {{ corp_excluded_line(corp_excluded.get("qm")) }}
  {% if qm_diag and qm_diag.ok is sameas false %}
  <div class="small" style="font-size:12.5px;color:var(--red)">Скенерът не се изпълни{% if qm_diag.error %} ({{ qm_diag.error }}){% endif %} — празният списък НЕ значи, че няма кандидати за пробив.</div>
  {% else %}
  {% if qm_cards %}
  <div class="qm-grid">
    {% for c in qm_cards %}
    <div class="qm-card{{ ' in-screen' if c.ticker in our_qm else '' }}">
      <div class="qm-top"><span class="qm-sym">{{ c.ticker }}{% if c.ticker in our_qm %}{{ markers_html([{"tag": "QM✓", "title": "Тикърът е и в Action/Watchlist на днешния бриф — QM✓ стои и върху онази карта."}]) }}{% endif %}</span><span class="qm-price">${{ "%.2f"|format(c.close) }}</span></div>
      {% if c.company and c.company != c.ticker %}<div class="qm-company">{{ c.company|cname(34) }}</div>{% endif %}
      {# 22.10.2026 (етап 4): жив запис в книгата qm_breakout — новото ниво не е нов вход (RVTY 22.10) #}
      {% if c.get("book_open") %}<div class="si-flag" title="Книгата не прави втори запис, докато този е отворен.">📈 OPEN — вече отворена в книгата qm_breakout от {{ c.book_open.since[8:10] }}.{{ c.book_open.since[5:7] }}{% if c.book_open.price %} @ ${{ "%.2f"|format(c.book_open.price) }}{% endif %} — новото ниво не е нов вход</div>{% endif %}
      <div class="qm-stat" title="Ниво на пробива = най-високият High на последните {{ qm_trigger_bars }} сесии; +{{ "%.1f"|format(c.pct_to_trigger) }}% над затварянето">Вход над ${{ "%.2f"|format(c.trigger) }} <span class="qm-sm">(+{{ "%.1f"|format(c.pct_to_trigger) }}%)</span>{% if c.dist_adr is defined %} <span class="qm-sm">· до нивото {{ "%.2f"|format(c.dist_adr) }} ADR</span>{% endif %}</div>
      {% if c.earnings_warning %}<div class="earn-warn">{{ c.earnings_warning.text }}</div>{% endif %}
      {% if c.corp_action %}<div class="corp-warn">{{ c.corp_action.text }}</div>{% endif %}
      {% if c.get("spinoff_warning") %}<div class="corp-warn">{{ c.spinoff_warning.text }}</div>{% endif %}{% if c.get("merger_target") %}<div class="corp-warn">{{ c.merger_target.text }}</div>{% endif %}
      {% for n in c.cot_notes or [] %}<div class="cot-note">{{ n.text }}</div>{% endfor %}
      <div class="qm-kv">
        <span>ADR</span><b>{{ "%.1f"|format(c.adr) }}%</b>
        <span>Предходен ръст</span><b>+{{ "%.0f"|format(c.runup_pct) }}%</b>
        <span>Консолидация</span><b title="дълбочина {{ "%.1f"|format(c.depth_pct) }}% · стягане {{ "%.2f"|format(c.tight) }}× ADR · обем {{ "%.2f"|format(c.vol_ratio) }}× от 50-дневния · цена {{ "%+.1f"|format(c.vs_sma10_pct) }}% от 10 MA, {{ "%+.1f"|format(c.vs_sma20_pct) }}% от 20 MA">{{ c.base_days }} дни</b>
      </div>
      {{ levels_block(c.levels, false, false) }}
    </div>
    {% endfor %}
  </div>
  <div class="small" style="font-size:11.5px;color:var(--muted);margin-top:8px">
    {% if qm_diag and qm_diag.with_history %}Подредени по стягане на базата (най-стегнатите първи); лидери: горните {{ ((1 - qm_diag.lead_pct) * 100)|round|int }}% по ръст за 1, 3 и 6 месеца ({{ qm_diag.leaders }} от {{ qm_diag.with_history }} тикъра към
    {{ qm_diag.as_of[8:10] }}.{{ qm_diag.as_of[5:7] }}), кандидати {{ qm_diag.candidates }}{% if qm_diag.candidates > qm_cards|length %}, показани {{ qm_cards|length }}{% endif %}. {% endif %}{% if qm_diag and qm_diag.beyond_adr %}Още {{ qm_diag.beyond_adr }} кандидат(а) са на повече от {{ '%g'|format(qm_max_dist_adr) }}×ADR от нивото ({{ qm_diag.beyond_adr_tickers|join(", ") }}) — не се показват и не се записват. {% endif %}
    Задръж курсора върху консолидацията за подробности (дълбочина на базата, стягане, позиция спрямо 10/20 MA). Стопът за оразмеряване е максималният (1×ADR); реалният стоп е дъното на деня на влизане.
  </div>
  {% else %}
  <div class="small" style="font-size:12.5px;color:var(--muted)">няма кандидати днес{% if qm_diag and qm_diag.with_history %} (проверени {{ qm_diag.with_history }} тикъра){% endif %}{% if qm_diag and qm_diag.beyond_adr %}; още {{ qm_diag.beyond_adr }} са на повече от {{ '%g'|format(qm_max_dist_adr) }}×ADR от нивото ({{ qm_diag.beyond_adr_tickers|join(", ") }}) — не се показват{% endif %}</div>
  {% endif %}
  {% endif %}

  {# ── Измерване: отделната книга qm_breakout (свита; редът над нея казва главното) ── #}
  {% if qb and qb.enabled %}
  <details class="qm-book" style="margin-top:14px">
    <summary style="cursor:pointer;font-size:12.5px;color:var(--muted)">Измерване — книга qm_breakout: записани {{ qb.records }} · затворени {{ qb.closed }}{% if qb.stats_visible %} · win rate {{ qb.win_rate_pct }}%{% else %} · win rate след {{ qb.min_closed }} затворени{% endif %}</summary>
  {% if qb and qb.enabled %}
  {# 12.10.2026: флаг за малък риск на входа — R е раздут от знаменателя (само показване; изчислението на R не е променено) #}
  {% macro qm_tight(p, qb) %}<span style="color:var(--yellow)" title="Рискът на входа (вход − low на входния ден) е {{ "%.2f"|format(p.risk_adr) }}×ADR — под {{ qb.tight_risk_adr }}×ADR. R се смята от пода {{ qb.tight_risk_adr }}×ADR (12.10.2026): с реалния знаменател R би бил раздут — в реплея такива сделки са 12% и носеха 69% от сумата на R.">⚠ риск на входа {{ "%.2f"|format(p.risk_adr) }}×ADR — R от пода {{ qb.tight_risk_adr }}×ADR</span>{% endmacro %}
  {% set qb_res = {"stopped": "стоп", "trailing_stop_exit": "trailing изход", "expired": "изтекла по време"} %}
  {% set qb_st = {"pending": "чака пробива", "open": "отворена", "trailing": "след частична продажба (trailing)"} %}
  <div class="qm-sub">Измерване — книга qm_breakout (отделна от Action и buy-stop)</div>
  <div class="small" style="font-size:12.5px;color:var(--muted);margin:0 0 8px">
    Всеки показан кандидат се следи със симулация на неговите правила: вход на нивото на пробива само в сесията на брифа (гап над нивото с повече от {{ qm_chase_adr|round|int }}×ADR не се гони),
    стоп = low на входния ден (не по-широк от {{ qm_adr_stop|round|int }}×ADR), след {{ qm_partial_days }} сесии се продава {{ (qm_partial_fraction * 100)|round|int }}% със стоп на break-even, остатъкът — първо затваряне под
    SMA10 (ADR ≥ {{ qm_trail_switch|round|int }}%) или SMA20. <b>Входът и стопът — от 5-минутните бари на входния ден</b>: кога е пробито нивото, стопът е дъното на деня до пробива,
    а по-късен бар под него значи стоп в същия ден — един R. yfinance пази 5-минутни бари ~60 дни; където ги няма, остават <b>двете граници</b> по дневния бар: <b>opt</b> (low-ът е бил
    преди входа) и <b>pess</b> (денят затваря под входа → загуба до стопа), с етикет.
    <b>R = печалба ÷ max(вход − low на входния ден, {{ qm_r_floor }}×ADR)</b> — при гап над нивото дъното на деня може да е на центове от входа и R би бил раздут; до R стои доходността в %.
    Без плъзгане и комисионни. Не са позиции и не са съвет за покупка.</div>
  <div class="prose">
    {% if not qb.records %}
    <b>Още няма записани кандидати</b> — записват се показаните breakout карти{% if qb.track_from %}, от {{ qb.track_from }} нататък (чист старт){% endif %}.<br>
    {% else %}
    <b>Записани: {{ qb.records }}</b> · чакат вход {{ qb.pending }} · отворени {{ qb.open }} · затворени {{ qb.closed }}
    · не се задействаха {{ qb.not_triggered }}{% if qb.not_triggered_pct is not none %} ({{ qb.not_triggered_pct }}% от приключилите прозорци){% endif %}{% if qb.skipped %}
    · пропуснати (гап/стоп над границите) {{ qb.skipped }}{% endif %}{% if qb.also_action %} · и в Action: {{ qb.also_action }}{% endif %}{% if qb.also_buystop %} · и в buy-stop: {{ qb.also_buystop }}{% endif %}{% if qb.tight_risk %} · <span style="color:var(--yellow)">с риск на входа под {{ qb.tight_risk_adr }}×ADR: {{ qb.tight_risk }} (R от пода)</span>{% endif %}<br>
    {% if qb.closed %}Затворени: {{ qb.closed }} · среден R: {% if not qb.get("closed_bounds") and qb.get("closed_5m") %}<b>{{ "%+.2f"|format(qb.avg_realized_r) }}</b> (5-минутни бари){% else %}<b>{{ "%+.2f"|format(qb.avg_realized_r) }}</b> (opt) / <b>{{ "%+.2f"|format(qb.avg_realized_r_pess) }}</b> (pess){% if qb.get("closed_5m") %} — {{ qb.closed_5m }} от {{ qb.closed }} с 5-минутни бари (там opt = pess), {{ qb.closed_bounds }} с двете граници{% endif %}{% endif %}{% if qb.avg_return_pct is not none %} · средна доходност на сделка {{ "%+.2f"|format(qb.avg_return_pct) }}% / {{ "%+.2f"|format(qb.avg_return_pct_pess) }}%{% endif %}<br>{% endif %}
    {{ events_line(qb.events, "R (opt)") }}
    {% if qb.stats_visible %}
    <b>Win rate: {{ qb.win_rate_pct }}%</b> opt / {{ qb.win_rate_pess_pct }}% pess ({{ qb.wins }} win / {{ qb.losses }} loss; 95% интервал {{ qb.win_ci_pct[0] }}–{{ qb.win_ci_pct[1] }}%)
    · медиана R {{ "%+.2f"|format(qb.median_realized_r) }} / {{ "%+.2f"|format(qb.median_realized_r_pess) }} · над 5R: {{ qb.big_winners_5r }}<br>
