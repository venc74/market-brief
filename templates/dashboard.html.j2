      {% if c.cross_sector_thesis %}{{ cot_sub(c.cross_sector_thesis, "Cross-sector теза") }}
      {% elif not c.thesis_rejected %}{{ cot_sub({"empty_reason": "причината не е записана"}, "Cross-sector теза") }}{% endif %}
    </div>
    {% endfor %}
  </div>
  {% if cot_rhythm.compact %}</details>{% endif %}
</section>
{% endif %}


