<!DOCTYPE html>
<html lang="bg">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Бриф · {{ date_human }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=Spectral:wght@600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #0b1220;          /* дълбоко мастилено синьо — небе преди отваряне */
    --panel: #111a2e;
    --panel-2: #16203a;
    --line: #233252;
    --text: #d9e1f2;
    --muted: #8593b3;
    --green: #34d399;
    --yellow: #fbbf24;
    --red: #f87171;
    {% if regime == "Offensive" %}--regime: #34d399; --regime-dim: rgba(52,211,153,.12);
    {% elif regime == "Cash" %}--regime: #f87171; --regime-dim: rgba(248,113,113,.12);
    {% else %}--regime: #fbbf24; --regime-dim: rgba(251,191,36,.12);{% endif %}
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background: var(--ink); color: var(--text);
    font-family: "IBM Plex Sans", sans-serif; font-size: 15px; line-height: 1.55;
  }
  .mono { font-family: "IBM Plex Mono", monospace; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px 60px; }

  /* ── Хедър: режимът Е дизайнът ── */
  header {
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, var(--regime-dim), transparent 70%);
    padding: 36px 0 28px;
  }
  .header-inner { max-width: 1080px; margin: 0 auto; padding: 0 20px;
    display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px; }
  .masthead h1 { font-family: "Spectral", serif; font-size: 26px; font-weight: 700; letter-spacing: .3px; }
  .masthead .date { color: var(--muted); font-size: 13px; margin-top: 4px; }
  .regime-badge {
    font-family: "IBM Plex Mono", monospace; font-size: 22px; font-weight: 600;
    color: var(--regime); border: 2px solid var(--regime); border-radius: 6px;
    padding: 10px 22px; letter-spacing: 2px; text-transform: uppercase;
    box-shadow: 0 0 28px var(--regime-dim);
  }
  .regime-reason { color: var(--muted); font-size: 13px; text-align: right; max-width: 360px; margin-top: 6px; }

  section { margin-top: 44px; }
  h2 {
    font-family: "IBM Plex Mono", monospace; font-size: 13px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 2.5px; color: var(--muted);
    border-bottom: 1px solid var(--line); padding-bottom: 10px; margin-bottom: 20px;
  }
  h2::before { content: "// "; color: var(--regime); }

  /* ── Термометър ── */
  .thermo { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
  .t-card {
    background: var(--panel); border: 1px solid var(--line); border-radius: 8px;
    padding: 14px 16px; border-top: 3px solid var(--line);
  }
  .t-card.info { border-style: dashed; }   /* пакет 2 т.2: информативен индикатор — показва се, не се брои */
  /* 29.10.2026 (разходката, т. 2): информативните — отделно под уредите, които решават; по-малки и по-бледи, не сгънати */
  .thermo-info { margin-top: 16px; opacity: .72; }
  .thermo-info-head { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); margin-bottom: 8px; }
  .thermo-info .thermo { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; }
  .thermo-info .t-card { padding: 10px 12px; border-top-width: 2px; }
  .thermo-info .t-name { font-size: 10px; }
  .thermo-info .t-val { font-size: 16px; margin-top: 4px; }
  .thermo-info .t-label { font-size: 11.5px; }
  .t-card.green { border-top-color: var(--green); }
  .t-card.yellow { border-top-color: var(--yellow); }
  .t-card.red { border-top-color: var(--red); }
  .t-name { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); }
  .t-val { font-family: "IBM Plex Mono", monospace; font-size: 21px; font-weight: 600; margin-top: 6px; }
  .t-label { font-size: 12px; color: var(--muted); margin-top: 4px; }

  .prose { background: var(--panel); border: 1px solid var(--line); border-left: 3px solid var(--regime);
    border-radius: 8px; padding: 20px 24px; font-size: 15.5px; }

  /* ── Сектори ── */
  .sectors { display: grid; gap: 12px; }
  .sector-row { background: var(--panel); border: 1px solid var(--line); border-radius: 8px;
    padding: 16px 20px; display: grid; grid-template-columns: 150px 1fr; gap: 16px; align-items: start; }
  .sector-name { font-weight: 600; }
  .sector-etf { font-family: "IBM Plex Mono", monospace; font-size: 12px; color: var(--regime); }
  .sector-chain { font-size: 14px; color: var(--text); }
  .canslim-book > summary { cursor: pointer; list-style-position: inside; }
  .canslim-book > summary h2 { display: inline; }
  .canslim-book > summary .book-hint { font-size: 12.5px; color: var(--muted); margin-left: 8px; }
  .sector-meta { font-size: 12px; color: var(--muted); margin-top: 4px; }

  /* ── Action карти ── */
  .stock-card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
    margin-bottom: 22px; overflow: hidden; }
  .stock-head { padding: 18px 24px; display: flex; justify-content: space-between;
    align-items: baseline; flex-wrap: wrap; gap: 8px;
    background: var(--panel-2); border-bottom: 1px solid var(--line); }
  .ticker { font-family: "IBM Plex Mono", monospace; font-size: 24px; font-weight: 600; color: var(--regime); }
  .company { color: var(--muted); font-size: 14px; margin-left: 10px; }
  .price-tag { font-family: "IBM Plex Mono", monospace; font-size: 18px; }
  .stock-body { padding: 20px 24px; display: grid; grid-template-columns: 1.4fr 1fr; gap: 24px; }
  @media (max-width: 760px) { .stock-body, .sector-row { grid-template-columns: 1fr; } }
  .block h3 { font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px;
    color: var(--muted); margin: 14px 0 6px; }
  .block h3:first-child { margin-top: 0; }
  .kv { display: grid; grid-template-columns: 1fr auto; gap: 2px 14px;
    font-size: 13.5px; padding: 3px 0; border-bottom: 1px dotted var(--line); }
  .kv b { font-family: "IBM Plex Mono", monospace; font-weight: 500; text-align: right; }
  .why { font-size: 14.5px; }
  ul.tight { padding-left: 18px; font-size: 13.5px; }
  ul.tight li { margin: 4px 0; }
  .plan { background: var(--regime-dim); border: 1px solid var(--regime);
    border-radius: 8px; padding: 14px 16px; margin-top: 12px; }
  .plan .kv { border-bottom-color: rgba(255,255,255,.08); }
  .warn { color: var(--yellow); font-size: 13px; }

  /* ── Watchlist ── */
  .watch-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px; }
  .watch-card { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 16px 18px; }
  .watch-card .ticker { font-size: 17px; color: var(--yellow); }
  .watch-card p { font-size: 13px; margin-top: 8px; color: var(--text); }
  .rs-badge { font-size: 11px; color: var(--muted); margin-left: 8px; white-space: nowrap; }
  .buy-stop { font-size: 12.5px; font-weight: 600; color: var(--green); margin-top: 6px; }
  .watch-trigger { font-size: 12.5px; color: var(--muted); margin-top: 8px;
    border-top: 1px dotted var(--line); padding-top: 8px; }

  /* ── v2: convergence маркери ── */
  /* 2026-09-23: смяна на AI модела / отхвърлен модел — най-горе в брифа */
  .model-banner { font-size: 13px; color: var(--yellow); background: rgba(251,191,36,.10);
                  border: 1px solid rgba(251,191,36,.35); border-radius: 8px;
                  padding: 10px 14px; margin-bottom: 14px; }
  .model-banner.rejected { color: var(--red); background: rgba(248,113,113,.10);
                           border-color: rgba(248,113,113,.35); }
  /* 2026-09-22: предишна позиция в същия тикър е приключила — виж
     main._last_resolved_positions(). Видим ред, не само marker tooltip:
     новият план носи реален риск в име, което току-що е струвало пари. */
  .re-entry { font-size: 12.5px; color: var(--yellow); background: rgba(251,191,36,.08);
              border-left: 2px solid var(--yellow); padding: 7px 11px; margin: 0 16px 10px; }
  /* пакет 4б т.д: предупреждение за отчет върху картата (само информация) */
  .earn-warn { font-size: 12.5px; color: var(--yellow); background: rgba(251,191,36,.08);
               border-left: 2px solid var(--yellow); padding: 7px 11px; margin: 0 16px 10px; }
  .watch-card .earn-warn { margin: 6px 0 4px; }
  /* 09.10: корпоративно действие (отделяне / нецял сплит коефициент) — историята около датата е приблизителна; само информация */
  .corp-warn { font-size: 12.5px; color: var(--yellow); background: rgba(251,191,36,.08); border-left: 2px solid var(--yellow); padding: 7px 11px; margin: 0 16px 10px; }
  .watch-card .corp-warn, .qm-card .corp-warn, .glb-card .corp-warn { margin: 6px 0 4px; }
  /* 08.10: бележка за обратен залог — COT тезата казва обратното на сетъпа (сглобена от кода, само информация) */
  .cot-note { font-size: 12.5px; color: var(--yellow); background: rgba(251,191,36,.06);
              border-left: 2px solid var(--yellow); padding: 6px 11px; margin: 0 16px 8px; }
  .watch-card .cot-note, .qm-card .cot-note { margin: 6px 0 4px; }
  .opp-note { font-size: 12px; color: var(--yellow); margin-top: 3px; }
  /* 08.10 (2в): подгрупи в каре "Контекст" */
  .ctx-group { margin-top: 8px; padding-top: 6px; border-top: 1px dashed var(--border, rgba(255,255,255,.12)); }
  .ctx-group-name { font-weight: 600; font-size: 12.5px; margin-bottom: 2px; }
  .markers { display: inline-flex; gap: 6px; flex-wrap: wrap; margin-left: 12px; vertical-align: middle; }
  .marker { font-family: "IBM Plex Mono", monospace; font-size: 11px; font-weight: 600;
    padding: 2px 8px; border-radius: 4px; background: var(--regime-dim);
    color: var(--regime); border: 1px solid var(--regime); cursor: help; }
  .watch-card .markers { margin-left: 8px; }
  /* 2026-10-03 (пакет 4а т.2): маркерът се отваря и с клик (мобилно няма hover) */
  .marker { position: relative; }
  .marker .marker-tip { display: none; position: absolute; left: 0; top: 100%; z-index: 20; margin-top: 4px;
    min-width: 220px; max-width: 360px; padding: 8px 10px; border-radius: 6px; background: var(--card, #111827);
    color: var(--text); border: 1px solid var(--line); font-family: inherit; font-weight: 400; font-size: 12px;
    white-space: pre-line; text-align: left; box-shadow: 0 6px 18px rgba(0,0,0,.35); }
  .marker.open .marker-tip { display: block; }
  /* 2026-10-03 (пакет 4а т.7): давност и причина при празен/остарял днешен резултат */
  .data-note { font-size: 12.5px; color: var(--muted); margin: 0 0 10px; }
  .data-note.warn { color: var(--yellow); border-left: 2px solid var(--yellow); padding: 4px 10px; }

  /* ── 🔎 Наблюдавани тикъри (2026-09-18) ── */
  .wm-note { font-size: 12.5px; color: var(--muted); margin-bottom: 10px; }
  .wm-note code { font-family: "IBM Plex Mono", monospace; font-size: 12px; }
  .wm-summary { font-size: 13.5px; margin-top: 9px; }
  .wm-news { margin: 8px 0 0 0; padding-left: 18px; font-size: 13px; }
  .wm-news li { margin-bottom: 3px; }
  .wm-src { color: var(--muted); font-size: 12px; }
  .wm-insider { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 12.5px; }
  .wm-insider th { text-align: left; color: var(--muted); font-weight: 500;
                      border-bottom: 1px solid var(--line); padding: 4px 6px; }
  .wm-insider td { padding: 4px 6px; border-bottom: 1px solid var(--line); }
  .wm-insider .num { text-align: right; font-family: "IBM Plex Mono", monospace; }
  .wm-insider td.buy { color: var(--green); }
  .wm-insider td.sell { color: var(--red); }
  .wm-read { font-size: 13px; margin-top: 9px; }
  .wm-xref { font-size: 12.5px; color: var(--regime); margin-top: 7px; }
  /* 29.10.2026 (разходката, т. 6): една таблица — ред на тикър с факти от кода; новините, Form 4 и AI резюмето се разгъват с клик под реда */
  .wt { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .wt-row { display: grid; grid-template-columns: 1.35fr 1fr .95fr 1fr .85fr 1.75fr 1.05fr; gap: 8px; padding: 8px 12px; border-bottom: 1px solid var(--line);
    font-size: 12.5px; align-items: baseline; }
  .wt-head { font-size: 10.5px; text-transform: uppercase; letter-spacing: .8px; color: var(--muted); }
  .wt > :last-child, .wt > :last-child .wt-row { border-bottom: 0; }
  .wt-t { font-family: "IBM Plex Mono", monospace; font-weight: 600; font-size: 13.5px; }
  .wt-name { display: block; font-size: 11px; color: var(--muted); font-weight: 400; font-family: "IBM Plex Sans", sans-serif; }
  .wt-num { font-family: "IBM Plex Mono", monospace; }
  .wt-up { color: var(--green); } .wt-dn { color: var(--red); } .wt-mu { color: var(--muted); }
  .wt-mark { font-family: "IBM Plex Mono", monospace; font-size: 10.5px; padding: 1px 6px; border-radius: 4px; background: rgba(133,147,179,.14); margin: 0 3px 3px 0; display: inline-block; }
  details.wt-item > summary { list-style: none; cursor: pointer; }
  details.wt-item > summary::-webkit-details-marker { display: none; }
  details.wt-item > summary .wt-t::before { content: "▸ "; color: var(--regime); }
  details.wt-item[open] > summary .wt-t::before { content: "▾ "; }
  .wt-plain .wt-t::before { content: "  "; white-space: pre; }
  .wt-detail { padding: 2px 14px 12px 30px; border-bottom: 1px solid var(--line); }
  @media (max-width: 760px) {
    .wt-row { grid-template-columns: 1fr 1fr; gap: 4px 10px; }
    .wt-head { display: none; }
    .wt-row > [data-l]::before { content: attr(data-l) ": "; color: var(--muted); font-size: 11px; }
    .wt-detail { padding-left: 14px; }
  }

  /* ── v2: thesis monitor ── */
  .theses { display: grid; gap: 12px; }
  .thesis { background: var(--panel); border: 1px solid var(--line); border-radius: 8px;
    padding: 16px 20px; border-left: 3px solid var(--line); }
  .thesis.active { border-left-color: var(--green); }
  .thesis.structural { border-left-color: var(--regime); }
  .thesis.watch { border-left-color: var(--muted); }
  .thesis-head { display: flex; justify-content: space-between; align-items: baseline;
    flex-wrap: wrap; gap: 8px; }
  .thesis-name { font-weight: 600; font-size: 15px; }
  .thesis-status { font-family: "IBM Plex Mono", monospace; font-size: 11px;
    text-transform: uppercase; letter-spacing: 1px; padding: 2px 8px; border-radius: 4px; }
  .thesis-status.active { color: var(--green); background: rgba(52,211,153,.12); }
  .thesis-status.structural { color: var(--regime); background: var(--regime-dim); }
  .thesis-status.watch { color: var(--muted); background: rgba(133,147,179,.12); }
  .thesis-tickers { font-family: "IBM Plex Mono", monospace; font-size: 13px;
    color: var(--regime); margin-top: 6px; }
  .thesis-chain { font-size: 13.5px; color: var(--text); margin-top: 8px; }
  .thesis-trigger { font-size: 12.5px; color: var(--green); margin-top: 6px; }
  /* 2026-09-16: свереност срещу новините — само анотация, status е непроменен */
  .thesis-news { font-family: "IBM Plex Mono", monospace; font-size: 11px;
                 padding: 2px 7px; border-radius: 4px; margin-left: 6px; }
  .thesis-news.challenged { color: var(--red); background: rgba(248,113,113,.12); }
  .thesis-news.resolved { color: var(--muted); background: rgba(133,147,179,.12); }
  /* 2026-09-18: "evolving" — оригиналният път спрян, алтернативен напредва */
  .thesis-news.evolving { color: var(--yellow); background: rgba(251,191,36,.12); }
  .thesis-newsnote { font-size: 12.5px; color: var(--red); margin-top: 6px; }
  .thesis-headline { font-size: 12.5px; color: var(--text); margin-top: 6px; }   /* 19.10.2026 (т. 10): дословното заглавие до тезата — без етикет и без цвят на оценка */
  .thesis-newsnote.evolving { color: var(--yellow); }
  /* 2026-09-29: "confirmed" — събитие потвърждава механизма; тезата продължава */
  .thesis-news.confirmed { color: var(--green); background: rgba(52,211,153,.12); }
  .thesis-newsnote.confirmed { color: var(--green); }
  /* 2026-09-29: тикър от тезата без ценови данни (CEIX/TELL мълчаха месеци) */
  .thesis-missing { font-size: 12.5px; color: var(--red); margin-top: 6px; }
  /* FIX 2026-10-01 (т.2): механизмът е потвърден от новина, но цената още не
     го следва (мнозинство под 200DMA / RS отрицателен на 4с и 12с) — чисто
     визуално, не пипа news_status/laggard-leading гейтовете */
  .thesis-price-warn { color: var(--yellow); background: rgba(251,191,36,.12);
    font-size: 11px; font-weight: bold; padding: 2px 8px; border-radius: 4px;
    margin-left: 6px; }
  /* 2026-09-29: каре "Контекст" — само данни, без AI текст */
  .thesis-ctx { margin-top: 10px; padding: 10px 12px; border: 1px dashed var(--line);
                border-radius: 6px; background: var(--panel-2); overflow-x: auto; }
  .ctx-title { font-size: 10.5px; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); }
  .ctx-summary { font-family: "IBM Plex Mono", monospace; font-size: 13px; margin-top: 4px; }
  .ctx-meta { font-size: 12px; color: var(--muted); margin-top: 4px; }
  .ctx-meta b { color: var(--text); font-weight: 500; }
  .ctx-table { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 12.5px; }
  .ctx-table th { text-align: left; color: var(--muted); font-weight: 500;
                  border-bottom: 1px solid var(--line); padding: 3px 6px; }
  .ctx-table td { padding: 3px 6px; border-bottom: 1px solid var(--line); }
  .ctx-table .num { text-align: right; font-family: "IBM Plex Mono", monospace; }
  .ctx-table .mono { font-family: "IBM Plex Mono", monospace; }
  .thesis-ctx .pos { color: var(--green); }
  .thesis-ctx .neg { color: var(--red); }
  .thesis-ctx .na, .thesis-ctx .warn-txt { color: var(--yellow); }
  .cot-direction { font-family: "IBM Plex Mono", monospace; font-size: 11px;
    text-transform: uppercase; letter-spacing: 1px; padding: 2px 8px; border-radius: 4px; }
  .cot-direction.bullish { color: var(--green); background: rgba(52,211,153,.12); }
  .cot-direction.bearish { color: var(--red); background: rgba(248,113,113,.12); }
  .cot-direction.conflict { color: var(--yellow); background: rgba(251,191,36,.12); }
  .cot-percentile { font-family: "IBM Plex Mono", monospace; font-size: 11px; color: var(--muted); }
  .cot-sub { font-size: 13px; margin-top: 8px; padding-top: 8px; border-top: 1px dashed var(--line); }
  .cot-sub-label { font-size: 11px; text-transform: uppercase; letter-spacing: .5px;
    color: var(--muted); margin-bottom: 3px; }
  .cot-tickers { font-family: "IBM Plex Mono", monospace; color: var(--regime); }

  /* ── v2: signal таблици (unusual options / splits) ── */
  .signal-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .signal-chip { background: var(--panel); border: 1px solid var(--line); border-radius: 8px;
    padding: 12px 14px; }
  .signal-chip .sym { font-family: "IBM Plex Mono", monospace; font-size: 16px; font-weight: 600; }
  .signal-chip.calls .sym { color: var(--green); }
  .signal-chip.puts .sym { color: var(--red); }
  .signal-chip .note { font-size: 12px; color: var(--muted); margin-top: 4px; }
  .signal-chip .in-screen { font-size: 10.5px; font-family: "IBM Plex Mono", monospace;
    color: var(--regime); margin-top: 4px; }
  .split-tag { font-family: "IBM Plex Mono", monospace; font-size: 10px; text-transform: uppercase;
    letter-spacing: .5px; padding: 1px 6px; border-radius: 4px; margin-left: 8px; vertical-align: middle; }
  .split-tag.fwd { color: var(--green); background: rgba(52,211,153,.12); }
  .split-tag.rev { color: var(--red); background: rgba(248,113,113,.12); }
  /* 2026-09-27: сплитове — секцията вече не се скрива (празно / провал / приоритетни) */
  .splits-empty { font-size: 13px; color: var(--text); }
  .splits-funnel { font-size: 12px; color: var(--muted); margin-top: 4px; }
  .splits-warn { font-size: 13px; color: var(--red); background: rgba(248,113,113,.10);
                 border: 1px solid rgba(248,113,113,.35); border-radius: 8px; padding: 10px 14px; }
  .splits-priority { margin-bottom: 12px; }
  .signal-chip.split-pos { border-color: var(--yellow); }
  .signal-chip .split-badge { font-size: 11px; font-family: "IBM Plex Mono", monospace;
    color: var(--yellow); margin-top: 4px; }

  /* ── v2: Superinvestor Moves ── */
  .si-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .si-card { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px; }
  .si-card.in-screen { border-color: var(--regime); box-shadow: 0 0 0 1px var(--regime-dim); }
  .si-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .si-sym { font-family: "IBM Plex Mono", monospace; font-size: 17px; font-weight: 600; color: var(--text); }
  .si-val { font-family: "IBM Plex Mono", monospace; font-size: 14px; color: var(--green); }
  .si-action { font-family: "IBM Plex Mono", monospace; font-size: 10.5px; text-transform: uppercase;
    letter-spacing: 1px; padding: 1px 7px; border-radius: 4px; background: rgba(52,211,153,.12); color: var(--green); }
  .si-mgr { font-size: 12.5px; color: var(--muted); margin-top: 6px; }
  .si-flag { font-size: 10.5px; font-family: "IBM Plex Mono", monospace; color: var(--regime); margin-top: 6px; }
  /* 2026-09-21: сдвоен S+P трансфер — изключен от агрегатите, но видим */
  .si-transfer { margin-top: 8px; padding-top: 7px; border-top: 1px dashed var(--line); }
  .si-transfer-head { font-size: 10.5px; font-family: "IBM Plex Mono", monospace;
                      color: var(--yellow); }
  .si-transfer-row { font-size: 11.5px; color: var(--muted); margin-top: 3px; }
  .si-card.exit { border-left: 3px solid var(--red); }
  .si-pct { font-family: "IBM Plex Mono", monospace; font-size: 14px; }
  .si-pct.new { color: var(--green); }
  .si-pct.exit { color: var(--red); }
  .si-stopped-note { font-size: 12.5px; color: var(--muted); margin-top: 12px; padding: 10px 14px;
    background: var(--panel); border: 1px dashed var(--line); border-radius: 8px; }
  .si-stopped-note b { color: var(--yellow); }

  /* ── GLB (Green Line Breakout) Watchlist ── */
  .glb-group-label { font-family: "IBM Plex Mono", monospace; font-size: 11px; text-transform: uppercase;
    letter-spacing: 1px; margin: 14px 0 8px; }
  .glb-group-label.classic { color: var(--green); }
  .glb-group-label.momentum { color: var(--yellow); }
  .glb-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; margin-bottom: 6px; }
  .glb-card { background: var(--panel); border: 1px solid var(--line); border-left: 3px solid var(--muted);
    border-radius: 8px; padding: 12px 16px; }
  .glb-card.classic { border-left-color: var(--green); }
  .glb-card.momentum { border-left-color: var(--yellow); }
  .glb-card.in-screen { box-shadow: 0 0 0 1px var(--regime-dim); }
  .glb-top { display: flex; justify-content: space-between; align-items: baseline; }
  .glb-sym { font-family: "IBM Plex Mono", monospace; font-size: 16px; font-weight: 600; color: var(--text); }
  .glb-company { font-size: 12.5px; color: var(--text); margin-top: 2px; }
  .glb-price { font-family: "IBM Plex Mono", monospace; font-size: 13px; color: var(--muted); }
  .glb-stat { font-size: 13.5px; font-weight: 600; margin-top: 6px; }
  .glb-card.classic .glb-stat { color: var(--green); }
  .glb-card.momentum .glb-stat { color: var(--yellow); }
  .glb-detail { font-size: 12px; color: var(--muted); margin-top: 3px; }
  .glb-caveat { font-size: 11.5px; color: var(--yellow); margin-top: 6px; }
  .glb-note { font-size: 12px; color: var(--text); margin-top: 8px; padding-top: 8px; border-top: 1px dashed var(--line); }
  .glb-insufficient-note { font-size: 12px; color: var(--muted); margin-top: 10px; font-style: italic; }

  /* ── Qullamaggie сетъпи (отделна стратегия — измерване, не препоръка) ── */
  .qm-banner { font-size: 12.5px; color: var(--yellow); background: rgba(251,191,36,.08); border: 1px solid rgba(251,191,36,.35);
    border-radius: 6px; padding: 9px 12px; margin: 0 0 12px; line-height: 1.5; }
  .qm-sub { font-family: "IBM Plex Mono", monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 1px;
    color: var(--yellow); margin: 18px 0 8px; }
  .qm-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(285px, 1fr)); gap: 10px; margin-bottom: 6px; }
  .qm-card { background: var(--panel); border: 1px solid var(--line); border-left: 3px solid var(--yellow);
    border-radius: 8px; padding: 12px 16px; }
  .qm-card.in-screen { box-shadow: 0 0 0 1px var(--regime-dim); }
  .qm-top { display: flex; justify-content: space-between; align-items: baseline; }
  .qm-sym { font-family: "IBM Plex Mono", monospace; font-size: 16px; font-weight: 600; color: var(--text); }
  .qm-company { font-size: 12.5px; color: var(--text); margin-top: 2px; }
  .qm-price { font-family: "IBM Plex Mono", monospace; font-size: 13px; color: var(--muted); }
  .qm-stat { font-size: 13px; font-weight: 600; margin-top: 4px; color: var(--yellow); }
  .qm-detail { font-size: 12px; color: var(--muted); margin-top: 3px; }
  .qm-detail b { color: var(--text); font-weight: 600; }
  .qm-note { font-size: 11.5px; color: var(--text); margin-top: 8px; padding-top: 8px; border-top: 1px dashed var(--line); }
  .qm-sm { font-size: 11.5px; font-weight: 400; color: var(--muted); }
  .qm-kv { display: grid; grid-template-columns: 1fr auto; gap: 3px 10px; font-size: 12px; margin-top: 8px; color: var(--muted); }
  .qm-kv span, .qm-kv b { white-space: nowrap; }
  .qm-kv b { color: var(--text); font-weight: 600; text-align: right; font-family: "IBM Plex Mono", monospace; font-size: 12px; }
  .qm-card { padding: 10px 12px; }
  .qm-card .markers { margin-left: 6px; }
  .qm-ep-table td { vertical-align: top; }
  .qm-ep-sum { font-size: 12.5px; color: var(--text); margin-top: 4px; }
  .qm-ep-hl { font-size: 11.5px; color: var(--muted); margin-top: 2px; }

  /* ── news_aggregator: Значими новини ── */
  .news-list { display: grid; gap: 10px; }
  .news-item { display: flex; gap: 12px; align-items: flex-start;
    background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; }
  .news-dot { flex: 0 0 auto; width: 7px; height: 7px; border-radius: 50%; background: var(--regime); margin-top: 8px; }
  .news-head { font-weight: 600; font-size: 14px; color: var(--text); }
  /* 29.10.2026 (разходката, т. 3–4): заглавието е линк към статията — без отделен ред */
  a.news-head { text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }
  a.news-head:hover { text-decoration-color: var(--muted); }
  .news-why { font-size: 13.5px; color: var(--muted); }

  /* ── Track Record: Open Positions таблица ── */
  .pos-table { width: 100%; border-collapse: collapse; }
  .pos-table th, .pos-table td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--line); font-size: 13.5px; }
  .pos-table th { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); font-weight: 600; }
  .pos-table td.n, .pos-table th.n { text-align: right; font-family: "IBM Plex Mono", monospace; }
  .pos-table .sym { font-family: "IBM Plex Mono", monospace; font-weight: 600; }
  .pos-row-up { background: rgba(52,211,153,.06); }
  .pos-row-up td.n.pct { color: var(--green); }
  .pos-row-down { background: rgba(248,113,113,.06); }
  .pos-row-down td.n.pct { color: var(--red); }

  /* 2026-10-03 (пакет 4а т.3): widget-ът за търсене на Borrow Rate е махнат (CORS proxy-то беше ненадеждно);
     2026-10-06 (пакет 4б т.ж): махнат е и редът с borrow данните върху картите (дълги swing позиции) */

  /* ── v2: исторически календар ── */
  .calendar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 14px 18px; }
  .calendar label { font-size: 13px; color: var(--muted); }
  .calendar input[type="date"] { background: var(--panel-2); color: var(--text);
    border: 1px solid var(--line); border-radius: 6px; padding: 8px 10px;
    font-family: "IBM Plex Mono", monospace; font-size: 14px; color-scheme: dark; }
  .calendar button { background: var(--regime); color: var(--ink); border: none;
    border-radius: 6px; padding: 9px 18px; font-weight: 600; font-size: 13px; cursor: pointer;
    font-family: "IBM Plex Sans", sans-serif; }
  .calendar button:hover { filter: brightness(1.08); }
  .calendar .hint { font-size: 12px; color: var(--muted); }
  #history-frame { width: 100%; border: 1px solid var(--line); border-radius: 8px;
    margin-top: 16px; height: 0; transition: height .2s; background: var(--ink); }
  #history-msg { font-size: 13px; color: var(--yellow); margin-top: 10px; }

  footer { margin-top: 60px; border-top: 1px solid var(--line); padding-top: 20px;
    font-size: 12px; color: var(--muted); }
  @media (prefers-reduced-motion: no-preference) {
    .regime-badge { animation: pulse 4s ease-in-out infinite; }
    @keyframes pulse { 50% { box-shadow: 0 0 44px var(--regime-dim); } }
  }

  /* ── v2: Earnings Season Recap — икона + модал (не hover tooltip) ── */
  .earn-icon { display: inline-flex; cursor: pointer; margin-left: 7px; vertical-align: middle; }
  .earn-icon.earn-green { color: var(--green); }
  .earn-icon.earn-yellow { color: var(--yellow); }
  .earn-icon.earn-red { color: var(--red); }
  .earn-icon.earn-na { color: var(--muted); }
  /* НЕ position:fixed — position:absolute + JS позиционира top спрямо
     window.scrollY при отваряне, за да "покрие" текущия viewport, без
     да разчита на fixed positioning. */
  .earn-modal { position: absolute; left: 0; right: 0; height: 100vh;
    background: rgba(4,8,18,.72); display: flex; align-items: flex-start;
    justify-content: center; padding-top: 60px; z-index: 50; }
  .earn-modal[hidden] { display: none; }
  .earn-modal-content { background: var(--panel); border: 1px solid var(--line);
    border-radius: 10px; padding: 22px 24px; max-width: 540px; width: 92%;
    position: relative; max-height: 80vh; overflow-y: auto; }
  .earn-modal-close { position: absolute; top: 12px; right: 16px; background: none;
    border: none; color: var(--muted); font-size: 22px; line-height: 1; cursor: pointer; }
  .earn-modal-close:hover { color: var(--text); }
  .earn-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 10px; }
  .earn-table th { text-align: left; font-size: 10.5px; text-transform: uppercase;
    letter-spacing: .5px; color: var(--muted); padding: 4px 8px 6px 0; border-bottom: 1px solid var(--line); }
  .earn-table td { padding: 6px 8px 6px 0; border-bottom: 1px solid var(--line);
    font-family: "IBM Plex Mono", monospace; }
  .earn-yoy-row { background: rgba(255,255,255,.03); }
  .earn-yoy-label { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .5px; }
  .earn-pos { color: var(--green); }
  .earn-neg { color: var(--red); }
  .earn-yoy-summary { font-size: 12.5px; color: var(--muted); margin-top: 12px; line-height: 1.5; }

  /* ── Стоп и размер (07.10.2026): нива от брифа + оразмеряване в браузъра (localStorage) ── */
  header { position: relative; }
  .mb-gear { position: absolute; top: 10px; right: 14px; background: none; border: 1px solid var(--line); color: var(--muted); border-radius: 6px;
    font-size: 16px; line-height: 1; padding: 6px 9px; cursor: pointer; }
  .mb-gear:hover, .mb-gear[aria-expanded="true"] { color: var(--text); border-color: var(--regime); }
  .mb-settings { background: var(--panel); border-bottom: 1px solid var(--line); }
  .mb-settings[hidden] { display: none; }
  .mb-settings-inner { max-width: 1080px; margin: 0 auto; padding: 14px 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px 16px; align-items: end; }
  .mb-settings label { font-size: 12px; color: var(--muted); display: flex; flex-direction: column; gap: 4px; }
  .mb-settings input[type=number], .lv-adj input { background: var(--ink); border: 1px solid var(--line); color: var(--text); border-radius: 6px; padding: 8px 10px;
    font: 14px "IBM Plex Mono", monospace; width: 100%; }
  .mb-settings .mb-streak { color: var(--text); font-size: 12.5px; }
  .mb-settings .mb-check { flex-direction: row; align-items: center; gap: 8px; color: var(--text); }
  .mb-note { grid-column: 1 / -1; font-size: 11.5px; color: var(--muted); }
  .mb-note[hidden] { display: none; }
  .lv { margin-top: 10px; padding-top: 8px; border-top: 1px dashed var(--line); font-size: 12.5px; }
  .lv-row { display: flex; justify-content: space-between; gap: 12px; color: var(--muted); padding: 1px 0; }
  .lv-row b { color: var(--text); font-family: "IBM Plex Mono", monospace; font-weight: 600; text-align: right; }
  .lv-row i { font-style: normal; font-weight: 400; color: var(--muted); font-size: 11.5px; }
  .lv-note { font-size: 11.5px; color: var(--muted); margin-top: 3px; }
  .lv-warn { font-size: 12px; color: var(--yellow); margin-top: 4px; }
  .lv-hint { color: var(--muted); font-size: 12px; }
  .lv-size { margin-top: 6px; padding: 6px 8px; background: rgba(255,255,255,.03); border-radius: 6px; }
  .lv-main { color: var(--text); font-size: 13px; margin-top: 2px; }
  .lv-risk, .lv-loss { color: var(--muted); font-size: 12px; margin-top: 2px; }
  .lv-size b { color: var(--text); font-family: "IBM Plex Mono", monospace; font-weight: 600; }
  .lv-actions { margin-top: 6px; }
  .lv-adjust-btn, .lv-reset { background: none; border: 1px solid var(--line); color: var(--muted); border-radius: 6px; padding: 4px 10px; font-size: 12px; cursor: pointer; }
  .lv-adj { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: flex-end; }
  .lv-adj[hidden] { display: none; }
  .lv-adj label { font-size: 11.5px; color: var(--muted); display: flex; flex-direction: column; gap: 3px; flex: 1 1 110px; }
  .lv-adj .lv-note { flex-basis: 100%; }
  .qm-lv-row td { border-top: 0; padding-top: 0; }
  @media (max-width: 760px) { .mb-settings input[type=number], .lv-adj input { font-size: 16px; } }   /* без автоматично увеличение на iOS */
</style>
</head>
<body>

<header>
  <button id="mb-settings-btn" class="mb-gear" type="button" aria-expanded="false" aria-controls="mb-settings" title="Настройки за оразмеряване на позицията" aria-label="Настройки за оразмеряване на позицията">⚙</button>
  <div class="header-inner">
    <div class="masthead">
      <h1>Персонален AI Инвестиционен Бриф</h1>
      <div class="date mono">{{ date_human }} · генериран {{ generated_at }} {{ generated_tz }}{% if premarket_note %} · {{ premarket_note }}{% endif %}</div>
    </div>
    <div>
      <div class="regime-badge">{{ regime }}</div>
      {# FIX 2026-09-25: override-ът като ред НАД броенето, броенето — винаги.
         Дотук при override `regime_reason` подменяше броенето изцяло.
         Стари брифове без `counts` показват regime_reason както преди. #}
      {% if thermometer.counts is defined %}
        {% if thermometer.overrides %}<div class="regime-reason" style="color:var(--yellow)">{% for o in thermometer.overrides %}⚡ {{ o.text }}{% if not loop.last %}<br>{% endif %}{% endfor %}</div>{% endif %}
        {# пакет 2 т.10: override, освободен заради дълго отсъствие на данни — да се види в брифа #}
        {% if thermometer.hysteresis_released %}<div class="regime-reason" style="color:var(--yellow)">{% for r in thermometer.hysteresis_released %}⚡ Override-ът за {{ r.trigger }} е ОСВОБОДЕН: {{ r.hidden_days }} поредни дни без данни за индикатора — режимът е по броенето, не по override.{% if not loop.last %}<br>{% endif %}{% endfor %}</div>{% endif %}
        {# допълнение към пакет 2: червени distribution days блокират Offensive #}
        {% if thermometer.distribution_cap %}<div class="regime-reason" style="color:var(--yellow)">⚡ {{ thermometer.distribution_cap.text }}</div>{% endif %}
        <div class="regime-reason">{{ thermometer.counts }}{% if thermometer.overrides %} · по броене: {{ thermometer.regime_by_count }}{% endif %}</div>
      {% else %}
        <div class="regime-reason">{{ regime_reason }}</div>
      {% endif %}
    </div>
  </div>
</header>
{# 16.10.2026 (В2а/б): затворена борса днес (страницата показва последния бриф) и календарът за следващия работен ден #}
{% if closed_notice %}<div class="model-banner rejected">🛑 <strong>{{ closed_notice }}</strong></div>{% endif %}
{% if calendar_note %}<div class="model-banner">📅 {{ calendar_note }}</div>{% endif %}

{# 07.10.2026: настройки за оразмеряване — само в localStorage на устройството на читателя; в брифа няма размер на сметка и брой акции #}
<div id="mb-settings" class="mb-settings" data-regime-factor="{{ thermometer.sizing_factor if thermometer.sizing_factor is defined else 1 }}" hidden>
  <div class="mb-settings-inner">
    <label>Баланс на сметката ($)<input id="mb-balance" type="number" inputmode="decimal" min="0" step="any" placeholder="напр. 80000" autocomplete="off"></label>
    <label>Риск на сделка (% от сметката)<input id="mb-risk" type="number" inputmode="decimal" min="0" step="any" placeholder="0.5" autocomplete="off"></label>
    <label>Таван на позиция (% от сметката)<input id="mb-cap" type="number" inputmode="decimal" min="0" step="any" placeholder="25" autocomplete="off"></label>
    <label class="mb-check"><input id="mb-regime" type="checkbox" checked> прилагай режимния фактор (Action/Watchlist: ×0.5 при Defensive и Cash)</label>
    <div class="mb-note mb-streak" id="mb-streak" aria-live="polite"></div>
    <div class="mb-note">Стойностите остават само на това устройство (localStorage) — не се изпращат никъде и не са част от брифа. Размерът на позицията се смята в браузъра от нивата на картата.</div>
    <div class="mb-note" id="mb-persist-note" hidden>localStorage не е достъпен — настройките важат само докато страницата е отворена.</div>
  </div>
</div>

<div class="wrap">

{% if model_info and model_info.banner %}
<div class="model-banner">⚠ AI моделът се смени от <strong>{{ model_info.banner.from }}</strong>
  на <strong>{{ model_info.banner.to }}</strong> — следващите дни следим за промени
  в поведението (ден {{ model_info.banner.day }} от {{ model_info.banner.of }}).</div>
{% endif %}
{% if ai_truncations %}
<div class="model-banner rejected">✂ <strong>Отрязан AI отговор</strong> — следните секции
  са непълни или празни:
  <ul class="tight" style="margin:6px 0 0 18px">
  {# 29.10.2026: и рязане от наш филтър — поправката на JSON-а (json_repair) и махнатите изречения с чужди символи (cjk), не само лимитът за изход #}
  {% for t in ai_truncations %}<li><strong>{{ t.section }}</strong> — {% if t.kind == "json_repair" %}текстът е непълен днес: JSON-ът на модела
    беше счупен (най-често кавичка в текста) и поправката изряза част{% if t.tail %} — свършва на «…{{ t.tail }}»{% endif %}{% if t.retried %}; и повторният опит не помогна{% endif %}{% elif t.kind == "cjk" %}махнато изречение с чужди символи ({{ t.chars }}){% for r in t.removed %}
    «{{ r }}»{% endfor %}{% else %}моделът
    достигна лимита си за изход ({{ t.max_tokens }} токена, {{ t.model }}){% endif %}</li>{% endfor %}
  </ul></div>
{% endif %}
{# пакет 2 т.6: паднал Yahoo / празен универс — празният резултат не е "няма сетъпи" #}
{% if data_warnings %}
<div class="model-banner rejected">⚠ <strong>Проблем с данните днес</strong>
  <ul class="tight" style="margin:6px 0 0 18px">
  {% for w in data_warnings %}<li>{{ w.message }}</li>{% endfor %}
  </ul></div>
{% endif %}
{% if model_info and model_info.rejected %}
<div class="model-banner rejected">⛔ Моделът <strong>{{ model_info.rejected }}</strong> беше
  отхвърлен при проверката и брифът е генериран с <strong>{{ model_info.model }}</strong>.
  Причина: {{ model_info.rejected_reason }}</div>
{% endif %}

<section>
  <h2>Пазарен термометър</h2>
  {% macro t_card(ind) %}
    <div class="t-card {{ ind.status }}{% if ind.get('informational') %} info{% endif %}"{% if ind.get('methodology_note') %} title="{{ ind.methodology_note }}"{% endif %}>
      <div class="t-name">{{ ind.name }}</div>
      <div class="t-val">{{ ind.value if ind.value is not none else "—" }}</div>
      <div class="t-label">{{ ind.label }}</div>
    </div>
  {% endmacro %}
  <div class="thermo">
    {# 29.10.2026 (разходката, т. 2): горе — само уредите, които решават (броените + Distribution Days); информативните — в отделния блок по-долу #}
    {% for ind in thermometer.indicators if not ind.get('hide') and not ind.get('informational') %}{{ t_card(ind) }}{% endfor %}
    {% if not distribution_days and distribution_days_status and distribution_days_status.status == "failed" %}
    {# 16.10.2026 (В8): тегленето не успя — картата не изчезва, казва го #}
    <div class="t-card yellow"><div class="t-name">Distribution Days <span style="opacity:.6">(подобно на IBD)</span></div><div class="t-val">—</div>
      <div class="t-label">не се изтеглиха днес (нито SPY, нито QQQ) — блокът на Offensive не е проверен</div></div>
    {% endif %}
    {% if distribution_days %}
    <div class="t-card {{ distribution_days.status }}" title="{{ distribution_days.methodology_note or 'Подобно на distribution days на IBD: SPY/QQQ, без правилото за изтриване при +5%.' }}">
      <div class="t-name">Distribution Days <span style="opacity:.6">(подобно на IBD)</span></div>
      <div class="t-val">{{ distribution_days.count }}</div>
      <div class="t-label">{{ distribution_days.label }}</div>
    </div>
    {% endif %}
  </div>
  {# 15.10.2026: запас до смяна на режима — от кода (regime_claims.margin): колко червени сменят режима, distribution days, IEI/HYG спрямо прага, близките прагове #}
  {% if thermometer.regime_margin and thermometer.regime_margin.text %}
  <div class="small" style="font-size:12.5px;color:var(--muted);margin-top:8px"><b>Запас до смяна на режима:</b> {{ thermometer.regime_margin.parts|join(" · ") }}</div>
  {% endif %}
  {% set info_inds = thermometer.indicators|rejectattr('hide')|selectattr('informational')|list %}
  {% if info_inds or core_inflation is not none or pce_core is not none %}
  <div class="thermo-info">
  <div class="thermo-info-head">Информативни — не влизат в режима</div>
  <div class="thermo">
    {% for ind in info_inds %}{{ t_card(ind) }}{% endfor %}
    {# 2026-09-27: основна инфлация — информативна, не влиза в броенето/режима #}
    {% if core_inflation is not none %}
    {% set ci = core_inflation %}
    {# 29.10.2026 (разходката, т. 2, решение 2): за кой месец са данните (с годината) и закъснението — в самия надпис. Измерено в брифовете: августовските данни излязоха на 30.09 #}
    {# (брифът от 30.09 още показва юли, от 01.10 — август), т.е. в края на следващия месец — ~6 седмици след средата на отчетния, ~4 седмици след края му #}
    {% set ci_lag = "излизат с ~6 седмици закъснение (в края на следващия месец)" %}
    <div class="t-card info" title="Dallas Fed Trimmed Mean PCE, 12 месеца, % г/г (FRED PCETRIM12M159SFRBDAL). Месечна серия: данните за един месец излизат в края на следващия (~6 седмици след средата на месеца, ~4 седмици след края му); брифът ги взима на следващата сутрин.">
      <div class="t-name">Основна инфлация</div>
      {% if ci.value is not none %}
      <div class="t-val">{{ "%.2f"|format(ci.value) }}%</div>
      <div class="t-label"><b>данни за {{ ci.month }}{% if ci.date %} {{ ci.date[:4] }}{% endif %}</b> · {{ ci_lag }}{% if ci.avg_recent is defined %} · <span title="Средно {{ ci.recent_span }} срещу {{ ci.prior_span }}; под ±{{ ci.flat_threshold_pp }} пп = стабилна">{{ {'up': '↑ расте', 'down': '↓ пада', 'flat': '→ стабилна'}[ci.direction] }}: 3м средно {{ "%.2f"|format(ci.avg_recent) }}% срещу {{ "%.2f"|format(ci.avg_prior) }}%</span>{% elif ci.prev is defined %} · {{ {'up': '↑', 'down': '↓', 'flat': '→'}[ci.direction] }} {% if ci.direction == 'flat' %}без промяна спрямо{% else %}от{% endif %} {{ "%.2f"|format(ci.prev) }}% през {{ ci.prev_month }}{% endif %} · информативно, не влиза в режима</div>
      {% else %}
      <div class="t-val">—</div>
      <div class="t-label">{% if ci.stale %}застояли данни — последно за {{ ci.last_month }}{% if ci.last_date %} {{ ci.last_date[:4] }}{% endif %} ({{ ci.age_days }} дни){% else %}няма данни{% endif %} · {{ ci_lag }} · информативно, не влиза в режима</div>
      {% endif %}
    </div>
    {% endif %}
    {# 30.10.2026 (поправки от брифа, т. 6): базов PCE (без храни и енергия, FRED PCEPILFE) — до основната инфлация #}
    {% if pce_core is not none %}
    {% set pc = pce_core %}
    <div class="t-card info" title="Базов PCE ценови индекс (без храни и енергия), FRED PCEPILFE: годишно изменение. Излиза заедно с основната инфлация — в края на следващия месец.">
      <div class="t-name">Базов PCE</div>
      {% if pc.value is not none %}
      <div class="t-val">{{ "%.1f"|format(pc.value) }}%</div>
      <div class="t-label"><b>данни за {{ pc.month }} {{ pc.year }}</b> · г/г{% if pc.direction %} · {{ {'up': '↑ ускорява', 'down': '↓ забавя', 'flat': '→ без промяна'}[pc.direction] }} спрямо {{ pc.prev_month }} ({{ "%.1f"|format(pc.prev_value) }}%){% endif %} · {{ ci_lag if ci_lag is defined else "излизат с ~6 седмици закъснение (в края на следващия месец)" }} · информативно, не влиза в режима</div>
      {% else %}
      <div class="t-val">—</div>
      <div class="t-label">{% if pc.stale %}застояли данни — последно за {{ pc.last_month }} ({{ pc.age_days }} дни){% else %}няма данни{% endif %} · информативно, не влиза в режима</div>
      {% endif %}
    </div>
    {% endif %}
  </div>
  </div>
  {% endif %}
  {# 13.10.2026: скрит индикатор не изчезва без следа — ред с причината (Fed Net Liquidity на 13.10: RRP с последна точка 09.10, Columbus Day) #}
  {% set hidden = thermometer.indicators|selectattr('hide')|list %}
  {% if hidden %}
  <div class="small" style="font-size:12.5px;color:var(--muted);margin-top:8px"><b>Скрити днес:</b>
    {% for ind in hidden %}{{ ind.name }} — {{ ind.hide_reason or "няма данни" }}{% if ind.get('informational') %} (информативен, не влиза в режима){% endif %}{{ " · " if not loop.last else "" }}{% endfor %}
  </div>
  {% endif %}
</section>

{# 29.10.2026 (разходката, т. 3–4): заглавието е линк към статията, когато фийдът дава линк (само http/https) #}
{% macro news_head(n) %}{% if n.link and (n.link.startswith('https://') or n.link.startswith('http://')) %}<a class="news-head" href="{{ n.link }}" target="_blank" rel="noopener noreferrer">{{ n.headline }}</a>{% else %}<span class="news-head">{{ n.headline }}</span>{% endif %}{% endmacro %}
{# 29.10.2026 (разходката, т. 3–4, решение 2): една история — една новина; 30.10.2026 (поправки от брифа, т. 5): другите източници — само „+N източника“, без линкове #}
{% macro news_also(n) %}{% if n.also %} <span class="news-why" style="font-size:12px" title="{% for a in n.also %}{{ a.source }}{{ ', ' if not loop.last else '' }}{% endfor %}">· +{{ n.also|length }} {{ 'източник' if n.also|length == 1 else 'източника' }}</span>{% endif %}{% endmacro %}
{% if news %}
<section>
  <h2>Значими новини · последните 24ч</h2>
  <div class="news-list">
    {% for n in news %}
    <div class="news-item">
      <span class="news-dot"></span>
      {# 15.10.2026: заглавието е ДОСЛОВНО от източника (news_aggregator.pick_verbatim); преводът е отделно, в скоби #}
      <div>{{ news_head(n) }}{% if n.source %} <span class="news-why" style="font-size:12px">· {{ n.source }}</span>{% endif %}{{ news_also(n) }}
        {% if n.why %}<span class="news-why"> — {{ n.why }}</span>{% endif %}</div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{# 22.10.2026 (етап 4): крипто секцията — Cointelegraph (от 29.10 и CoinDesk) през AI подбор по индекс; заглавието и източникът — дословни; под новините цените и COT за Bitcoin при нов отчет #}
{% if crypto %}
<section>
  <h2>Крипто · последните 24ч</h2>
  {% if crypto.get("items") %}
  <div class="news-list">
    {% for n in crypto["items"] %}
    <div class="news-item"><span class="news-dot"></span>
      <div>{{ news_head(n) }}{% if n.source %} <span class="news-why" style="font-size:12px">· {{ n.source }}</span>{% endif %}{{ news_also(n) }}
        {% if n.cat_label %}<span class="news-why" style="font-size:12px">· {{ n.cat_label }}</span>{% endif %}{% if n.why %}<span class="news-why"> — {{ n.why }}</span>{% endif %}</div>
    </div>
    {% endfor %}
  </div>
  {% elif crypto.get("ok") %}
  <div class="prose">Няма значими крипто новини{% if crypto.pool %} (проверени {{ crypto.pool }} заглавия от {% set srcs = [] %}{% for k, v in (crypto.pool_sources or {}).items() if v.count %}{% set _ = srcs.append(k) %}{% endfor %}{{ srcs|join(' и ') if srcs else 'Cointelegraph' }}){% endif %}.</div>
  {% else %}
  <div class="prose" style="color:var(--muted)">Крипто новините не се изтеглиха днес{% if crypto.reason %} ({{ crypto.reason }}){% endif %} — празното НЕ значи, че няма новини.</div>
  {% endif %}
  {% if crypto.get("tickers") %}<div class="small" style="font-size:12.5px;margin-top:10px">
    {% for t in crypto.tickers %}<b>{{ t.ticker }}</b> ${{ "%.2f"|format(t.close) }} ({{ "%+.1f"|format(t.chg_1d_pct) }}% за сесията, {{ "%+.1f"|format(t.chg_5d_pct) }}% за 5){{ " · " if not loop.last else "" }}{% endfor %}
    <span style="color:var(--muted)"> — close към {{ crypto.tickers[0].date[8:10] }}.{{ crypto.tickers[0].date[5:7] }}</span></div>{% endif %}
  {% if crypto.get("cot_btc") %}<div class="small" style="font-size:12.5px;margin-top:6px">COT Bitcoin (CME, managed money): нетна позиция {{ "{:,}".format(crypto.cot_btc.net).replace(",", " ") }} договора към {{ crypto.cot_btc.as_of[8:10] }}.{{ crypto.cot_btc.as_of[5:7] }} — перцентил {{ "%.0f"|format(crypto.cot_btc.percentile) }} за {{ crypto.cot_btc.weeks }} седмици{% if crypto.cot_btc|cot_label %}: {{ crypto.cot_btc|cot_label }}{% endif %} (нов отчет).</div>{% endif %}
  <div class="small" style="font-size:11.5px;color:var(--muted);margin-top:8px">Подборът е на AI по въпроса „би ли променила тази новина решението на институционален инвеститор в крипто след седмица?“ (важни: навлизането на традиционните финанси — токенизация, DTCC, големи банки, стейбълкойни, регулатори; не: прогнози за цената, малки монети, мнения). Заглавието и източникът са дословни. Информация, не препоръка.</div>
</section>
{% endif %}

<section>
  <h2>Макро бриф</h2>
  {# 29.10.2026 (разходката, т. 5): разказ в 2–3 абзаца (празен ред между тях); абзацът на AI за режима е махнат — режимът е в термометъра, от кода #}
  <div class="prose">{% for para in macro_paragraphs %}<p style="margin:0{% if not loop.last %} 0 10px{% endif %}">{{ para }}</p>{% else %}{{ macro_brief }}{% endfor %}</div>
  {# 19.10.2026: договорът и часът на цената на фючърсите — от кода (CL=F в Yahoo вече е декемврийският, Reuters котира ноемврийския) #}
  {% if futures_line %}<div class="small" style="font-size:12px;color:var(--muted);margin-top:8px">{{ futures_line }}</div>{% endif %}
</section>

{# 08.10: секцията остава и при празен списък (data/watch_list.json) — иначе изчезва мълчаливо и не личи дали е проверена #}
{% if watch or watch_enabled %}
<section>
  <h2>🔎 Наблюдавани тикъри · последните 24ч</h2>
  <div class="wm-note">Ръчно поддържан списък (<code>data/watch_list.json</code>) —
    независим от скрийнъра, GLB и COT секциите.</div>
  {% if not watch %}
  <div class="small" style="font-size:12.5px;color:var(--muted)">Списъкът е празен — тикъри се добавят в <code>data/watch_list.json</code>; ефектът е видим в следващия дневен бриф.</div>
  {% endif %}
  {# 29.10.2026 (разходката, т. 6): ред с факти от кода (без AI); тикър със събития (новини / Form 4) се разгъва с клик; без събития — само редът #}
  {% macro wt_cells(w) %}{% set f = w.facts or {} %}{% set p = f.price or {} %}{% set sh = f.short or {} %}{% set e = f.earnings or {} %}
    <span class="wt-t">{{ w.ticker }}{% if w.name %}<span class="wt-name">{{ w.name }}</span>{% endif %}</span>
    <span data-l="Цена · ден" class="wt-num">{% if p.close is defined %}${{ "%.2f"|format(p.close) }} <span class="{{ 'wt-up' if p.chg_1d_pct > 0 else ('wt-dn' if p.chg_1d_pct < 0 else 'wt-mu') }}">{{ "%+.1f"|format(p.chg_1d_pct) }}%</span>{% else %}—{% endif %}</span>
    <span data-l="50 / 200DMA">{% if p.above_50 is defined %}<span class="{{ 'wt-up' if p.above_50 else 'wt-dn' }}">{{ 'над' if p.above_50 else 'под' }}</span>{% else %}<span class="wt-mu">—</span>{% endif %} / {% if p.above_200 is defined %}<span class="{{ 'wt-up' if p.above_200 else 'wt-dn' }}">{{ 'над' if p.above_200 else 'под' }}</span>{% else %}<span class="wt-mu" title="под 200 сесии история">—</span>{% endif %}</span>
    <span data-l="RS 4 / 12 седм."><span class="wt-num">{% for n in [20, 60] %}{% set v = p.get('rs_' ~ n) %}{% if v is not none %}<span class="{{ 'wt-up' if v > 0 else ('wt-dn' if v < 0 else 'wt-mu') }}">{{ "%+.1f"|format(v) }}</span>{% else %}<span class="wt-mu">—</span>{% endif %}{{ " / " if loop.first else "" }}{% endfor %}</span>{% if p.rs_word %}<span class="wt-name">{{ p.rs_word }}</span>{% endif %}</span>
    <span data-l="Отчет">{% if e.next %}{{ e.next[8:10] }}.{{ e.next[5:7] }}{% if e.days is not none %} <span class="wt-mu">({{ "днес" if e.days == 0 else ("след " ~ e.days ~ " дни" if e.days > 1 else "утре") }})</span>{% endif %}{% elif e.status == "no_date" %}<span class="wt-mu">няма дата</span>{% else %}<span class="wt-mu">—</span>{% endif %}</span>
    <span data-l="Short interest">{% if sh.pct_float is defined %}<span class="wt-num">{{ "%.1f"|format(sh.pct_float) }}%</span> от float{% if sh.days_to_cover is defined %} · {{ "%.1f"|format(sh.days_to_cover) }} дни{% endif %}{% if sh.chg_pct is defined %} · <span class="wt-num">{{ "%+.1f"|format(sh.chg_pct) }}%</span>{% if sh.prior_as_of %} <span class="wt-mu">спрямо {{ sh.prior_as_of[8:10] }}.{{ sh.prior_as_of[5:7] }}</span>{% endif %}{% endif %}{% if sh.as_of %} <span class="wt-mu">· към {{ sh.as_of[8:10] }}.{{ sh.as_of[5:7] }}</span>{% endif %}{% else %}<span class="wt-mu">—</span>{% endif %}</span>
    <span data-l="В брифа">{% for m in w.in_brief or [] %}<span class="wt-mark">{{ m }}</span>{% endfor %}{% if w.news %}<span class="wt-mark">{{ w.news|length }} новини</span>{% endif %}{% if w.insider_flags is defined %}{% for fl in w.insider_flags %}<span class="wt-mark" style="color:var({{ '--green' if fl.dir == 'P' else '--red' }}){% if fl.cluster %};font-weight:700{% endif %}" title="Form 4 за 30 дни: {{ fl.n }} сделки, {{ fl.owners }} инсайдъри, ${{ '{:,.0f}'.format(fl.value) }}">{% if fl.cluster %}CLUSTER {% endif %}{{ fl.label }} {{ fl.n }} · {{ fl.plan }}{% if fl.top_offplan %} · {{ fl.top_offplan.title or fl.top_offplan.owner }} ${{ '%.1f'|format(fl.top_offplan.value / 1e6) ~ ' млн' if fl.top_offplan.value >= 1e6 else '{:,.0f}'.format(fl.top_offplan.value) }} ({{ fl.top_offplan.date[8:10] }}.{{ fl.top_offplan.date[5:7] }}){% endif %}</span>{% endfor %}{% else %}{% if w.insider %}<span class="wt-mark" style="color:var(--yellow)">Form 4 · {{ w.insider|length }}</span>{% endif %}{% if w.insider_cluster %}<span class="wt-mark" style="color:var(--red)">CLUSTER</span>{% endif %}{% endif %}</span>
  {% endmacro %}
  {% if watch %}
  <div class="wt">
    <div class="wt-row wt-head"><span>Тикър</span><span>Цена · ден</span><span>50 / 200DMA</span><span>RS спрямо S&amp;P 4 / 12 седм.</span><span>Отчет</span><span>Short interest</span><span>В брифа · събития</span></div>
    {% for w in watch %}
    {% if w.quiet %}
    <div class="wt-row wt-plain">{{ wt_cells(w) }}</div>
    {% else %}
    <details class="wt-item">
      <summary class="wt-row">{{ wt_cells(w) }}</summary>
      <div class="wt-detail">
        {% if w.ai and w.ai.summary %}<div class="wm-summary">{{ w.ai.summary }}</div>{% endif %}
        {% if w.news %}
        <ul class="wm-news">
          {% for n in w.news %}
          <li>{% if n.link and (n.link.startswith('https://') or n.link.startswith('http://')) %}<a href="{{ n.link }}" target="_blank" rel="noopener noreferrer" style="color:var(--text)">{{ n.title }}</a>{% else %}{{ n.title }}{% endif %}{% if n.publisher %} <span class="wm-src">· {{ n.publisher }}</span>{% endif %}{% if n.when %} <span class="wm-src">· {{ n.when[8:10] }}.{{ n.when[5:7] }} {{ n.when[11:16] }} UTC</span>{% endif %}</li>
          {% endfor %}
        </ul>
        {% endif %}
        {% if w.insider %}
        <table class="wm-insider">
          <tr><th>Дата</th><th>Вид</th><th>Инсайдър</th><th class="num">Сума</th><th class="num">% от дял</th><th>План</th></tr>
          {% for t in w.insider %}
          <tr>
            <td>{{ t.date }}</td>
            <td class="{{ 'buy' if t.code == 'P' else 'sell' }}">{{ 'покупка' if t.code == 'P' else 'продажба' }}</td>
            {# FIX 2026-09-28: директорите нямат officerTitle в Form 4 → длъжността
               липсваше (BLSH, Andrew Bliss); is_director вече се парсва #}
            {% set roles = [t.owner_title] if t.owner_title else [] %}
            {% if t.is_director and 'director' not in (t.owner_title or '')|lower %}{% set roles = roles + ['директор'] %}{% endif %}
            <td>{{ t.owner_name }}{% if roles %} <span class="wm-src">· {{ roles|join(' · ') }}</span>{% endif %}</td>
            <td class="num">${{ "{:,.0f}".format(t.value) }}</td>
            <td class="num">{{ t.pct_of_holdings ~ "%" if t.pct_of_holdings is not none else "—" }}</td>
            <td>{{ "10b5-1" if t.planned_10b5_1 else ("извънпланова" if t.planned_10b5_1 is false else "неизв.") }}</td>
          </tr>
          {% endfor %}
        </table>
        {% endif %}
        {% if w.ai and w.ai.insider_read %}<div class="wm-read">{{ w.ai.insider_read }}</div>{% endif %}
        {% if w.ai and w.ai.cross_reference %}<div class="wm-xref">🔗 {{ w.ai.cross_reference }}</div>{% endif %}
      </div>
    </details>
    {% endif %}
    {% endfor %}
  </div>
  {# 30.10.2026 (поправки от брифа, т. 3): какво значи RS спрямо S&P 500 — една бележка под таблицата #}
  <div class="small" style="font-size:11.5px;color:var(--muted);margin-top:8px">RS 4 / 12 седм. — ръстът на акцията минус ръстът на S&amp;P 500 (SPY) за 4 и за 12 седмици, в процентни пунктове: +5 значи с 5 пункта по-добре от пазара. „Води пазара“ — по-добре и за двата периода; „набира сила“ — по-слабо за 12, по-добре за 4 седмици; „отслабва“ — обратното; „изостава“ — по-слабо и за двата.</div>
  {# 30.10.2026: AI резюметата са на групи по 4 — група, която не мина, е изписана; останалите са с резюме #}
  {% set ai_miss = [] %}{% for w in watch if w.ai and w.ai.missing %}{% set _ = ai_miss.append(w.ticker ~ " (" ~ w.ai.missing ~ ")") %}{% endfor %}
  {% if ai_miss %}<div class="small" style="font-size:12px;color:var(--yellow);margin-top:8px">AI резюме днес няма за: {{ ai_miss|join(", ") }} — групата им не мина; фактите, новините и Form 4 са от кода.</div>{% endif %}
  {% endif %}
</section>
{% endif %}

<section>
  <h2>Секторна карта · следващите 2–6 седмици</h2>
  <div class="sectors">
    {% if sector_card and sector_card.rows is defined %}
    {# 19.10.2026 (т. 18): секторите — водещите по кода (RS > 0 на 4 и 12 седмици или RS на 6-месечен връх); веригата — на модела #}
    {% for s in sector_card.rows %}
    <div class="sector-row">
      <div>
        <div class="sector-name">{{ s.sector }}</div>
        <div class="sector-etf">{{ s.etf }}</div>
      </div>
      <div>
        <div class="sector-chain">{% if s.chain %}{{ s.chain }}{% else %}<span style="color:var(--muted)">AI не даде верига за този сектор днес.</span>{% endif %}</div>
        <div class="sector-meta">{{ s.rs_line }}{% if s.horizon %} · хоризонт (AI): {{ s.horizon }}{% endif %}</div>
      </div>
    </div>
    {% else %}
    <div class="small" style="color:var(--muted)">Няма водещ сектор по RS днес (RS > 0 и на 4, и на 12 седмици, или RS на 6-месечен връх).</div>
    {% endfor %}
    {% if sector_card.omitted %}<div class="small" style="font-size:12px;color:var(--muted);margin-top:8px">Не са на картата (AI даде верига, но не са водещи по RS):
      {% for o in sector_card.omitted %}{{ o.etf }} ({{ o.rs_line|replace("RS спрямо SPY: ", "") }}){{ "; " if not loop.last else "." }}{% endfor %}</div>{% endif %}
    {% else %}
    {% for s in sector_logic %}
    <div class="sector-row">
      <div>
        <div class="sector-name">{{ s.sector }}</div>
        <div class="sector-etf">{{ s.etf }}</div>
      </div>
      <div>
        <div class="sector-chain">{{ s.chain|field_words }}</div>
        {% if s.horizon_weeks|horizon_text %}<div class="sector-meta">Хоризонт: {{ s.horizon_weeks|horizon_text }}</div>{% endif %}
      </div>
    </div>
    {% endfor %}
    {% endif %}
  </div>
</section>

{# FIX 2026-09-29: каре "Контекст" — само данни от кода (src/thesis_context.py) #}
{# маркери върху карти/позиции: hover (title) И клик (.marker-tip) — кой мениджър, от коя дата е filing-ът #}
{# 13.10.2026: бележка "предстои отделяне на ДД.ММ (запис ДД.ММ)" под тикъра в таблиците на книгите (backtest.apply_spinoff_notes) — само бележка; ръчният преглед е от деня на отделянето #}
{# 20.10.2026 (етап 3, т. 1): buy-stop се изпълнява при докосване — обемът на деня на входа се вижда при затварянето; групите са за отделни резултати #}
{% macro entry_vol_line(ev) %}{% if ev and (ev.high + ev.low + ev.unknown) %}<div class="small" style="font-size:12.5px;color:var(--muted);margin-top:6px">Денят на входа (по затварянето): обем ≥ {{ ev.mult|round(1) }}× среден — {{ ev.high }}{% if ev.high_avg_r is not none %} (среден R {{ "%+.2f"|format(ev.high_avg_r) }} при {{ ev.high_closed }} затворени){% endif %} · под {{ ev.mult|round(1) }}× — {{ ev.low }}{% if ev.low_avg_r is not none %} (среден R {{ "%+.2f"|format(ev.low_avg_r) }} при {{ ev.low_closed }} затворени){% endif %}{% if ev.unknown %} · без данни за обема — {{ ev.unknown }}{% endif %}{% if ev.excluded %} · без {{ ev.excluded }} с етикет deal / събитие{% endif %}. Buy-stop поръчката се изпълнява при докосване; обемът не е условие за входа.</div>{% endif %}{% endmacro %}
{# 26.10.2026 (етап 4б, т. 2): записите с етикет deal / „събитие/M&A“ и статистиката с тях и без тях (backtest.events_block) #}
{# 27.10.2026: етикетираните без затворена сделка (buy-stop 27.10: ROKU отворена) → „с тях“ и „без тях“ са едно и също число — вместо тях ред „още нямат затворени сделки“ #}
{% macro events_line(ev, unit) %}{% if ev %}<div class="small" style="font-size:12.5px;color:var(--muted);margin-top:6px">С етикет (цената следва сделка или слух за сделка, не сетъпа): {% for l in ev.labels %}<b>{{ l.ticker }}</b> {{ l.entry_date[8:10] }}.{{ l.entry_date[5:7] }} — {% if l.kind == "deal" %}deal ({{ l.text }}){% else %}събитие/M&amp;A{% if l.ret_pct is not none %} ({{ "%+.1f"|format(l.ret_pct) }}% при {{ "%.1f"|format(l.vol_x) }}× обем на {{ l.day[8:10] }}.{{ l.day[5:7] }}: «{{ l.text }}»){% endif %}{% endif %}{{ " · " if not loop.last else "" }}{% endfor %}.{% if ev.n_all and ev.n_all == ev.n_rest %} Средно {{ unit }}: етикетираните още нямат затворени сделки.{% elif ev.n_all %} Средно {{ unit }}: с тях {{ "%+.2f"|format(ev.avg_all) }} ({{ ev.n_all }}){% if ev.avg_rest is not none %} · без тях {{ "%+.2f"|format(ev.avg_rest) }} ({{ ev.n_rest }}){% else %} · без тях — още няма{% endif %}.{% endif %}</div>{% endif %}{% endmacro %}
{# 26.10.2026 (етап 4б, т. 1): етикет "deal" — записът е на цел на висяща сделка (backtest.apply_deal_labels): резултатът следва условията, не сетъпа #}
{% macro spinoff_note_html(p) %}{% if p.spinoff_note %}<div style="font-size:11.5px;color:var(--yellow);font-weight:400">⚠ {{ p.spinoff_note.text }}</div>{% endif %}{% if p.deal %}<div style="font-size:11.5px;color:var(--yellow);font-weight:400">deal · цел на придобиване{% if p.deal.buyer %} ({{ p.deal.buyer }}{% if p.deal.announced %}, {{ p.deal.announced[8:10] }}.{{ p.deal.announced[5:7] }}.{{ p.deal.announced[:4] }}{% endif %}){% endif %} — резултатът следва условията на сделката</div>{% endif %}{% endmacro %}
{% macro markers_html(markers) %}{% if markers %}<span class="markers">{% for m in markers %}<span class="marker" title="{{ m.title }}" tabindex="0" onclick="this.classList.toggle('open')">{{ m.tag }}<span class="marker-tip">{{ m.title }}</span></span>{% endfor %}</span>{% endif %}{% endmacro %}

{# 07.10.2026 (стоп и размер): нива на вход, стоп, ADR и предупреждения — ЕДНАКВИ за всички зрители (от брифа); размерът (акции, сума, загуба при стоп/гап) се смята в браузъра от настройките на читателя
   (sizing_core.js / sizing_ui.js). Без JS се виждат нивата и подсказката "въведи баланса…". #}
{% macro levels_block(lv, show_entry=true, show_adr=true) %}
{% if lv %}
<div class="lv" data-strategy="{{ lv.strategy }}" data-entry="{{ lv.entry }}" data-stop="{{ lv.stop }}" data-adr="{{ lv.adr_pct if lv.adr_pct is not none else '' }}" data-factor="{{ lv.regime_factor }}" data-regime-label="{{ 'защитен режим' if lv.regime_factor < 1 else '' }}" data-regime-note="{{ lv.regime_note or '' }}">
  <div class="lv-info">
    {% if show_entry %}<div class="lv-row"><span>{{ lv.entry_label }}</span><b>${{ "%.2f"|format(lv.entry) }}</b></div>{% endif %}
    <div class="lv-row"><span>{{ "Стоп" if lv.strategy == "canslim" else (lv.stop_source_text[0:1]|upper ~ lv.stop_source_text[1:]) }}</span><b>${{ "%.2f"|format(lv.stop) }} <i>(−{{ "%.1f"|format(lv.stop_pct) }}%)</i></b></div>
    {% if lv.expected_stop is defined %}<div class="lv-row"><span>{{ lv.expected_stop_label[0:1]|upper ~ lv.expected_stop_label[1:] }}</span><b>≈ ${{ "%.2f"|format(lv.expected_stop) }} <i>(−{{ "%.1f"|format(lv.expected_stop_pct) }}%)</i></b></div>{% endif %}
    {% if show_adr %}<div class="lv-row"><span>ADR (20 бара)</span><b>{{ ("%.1f"|format(lv.adr_pct) ~ "%") if lv.adr_pct is not none else "н/д" }}</b></div>{% endif %}
  </div>
  {% if lv.strategy == "canslim" %}<div class="lv-note">източник на стопа: {{ lv.stop_source_text }}</div>{% endif %}
  {% if lv.stop_note %}<div class="lv-note">{{ lv.stop_note }}</div>{% endif %}
  {% for w in lv.warnings %}<div class="lv-warn">⚠ {{ w }}</div>{% endfor %}
  <div class="lv-size" data-state="balance"><div class="lv-hint">въведи баланса в настройките, за да видиш размера на позицията</div></div>
  <div class="lv-actions"><button type="button" class="lv-adjust-btn" aria-expanded="false">коригирай</button></div>
  <div class="lv-adj" hidden>
    <label>реален вход<input class="lv-in-entry" type="number" step="any" inputmode="decimal"></label>
    <label>реален стоп<input class="lv-in-stop" type="number" step="any" inputmode="decimal"></label>
    <button type="button" class="lv-reset">върни</button>
    <div class="lv-note">само за тази карта — не се записва</div>
  </div>
</div>
{% endif %}
{% endmacro %}
{# статус на данни: остарели редове (дата на данните) и легитимна нула срещу провал при теглене #}
{% macro data_note(st, label) %}{% if st %}{% if st.stale %}
<div class="data-note warn">⚠ {{ label }}: показаното е от по-ранно теглене{% if st.data_date %} — данни от {{ st.data_date }}{% else %} — датата на теглене е неизвестна{% endif %}, не от днес.
  {% if st.kind == 'legit_zero' %}Днешното теглене е чисто, но празно: {{ st.note }}.{% elif st.kind == 'failed' %}Днешното теглене не успя: {{ st.note }}.{% endif %}</div>
{% elif st.kind == 'failed' %}<div class="data-note warn">⚠ {{ label }}: тегленето не успя — {{ st.note }}.</div>
{% elif st.kind in ['ok_partial', 'fallback_allact'] %}<div class="data-note warn">⚠ {{ label }}: {{ st.note }}.</div>
{% elif st.kind == 'legit_zero' %}<div class="data-note">{{ label }}: {{ st.note }}.</div>
{% endif %}{% endif %}{% endmacro %}
{# трети преглед (16.10): 13F — мениджъри без поредното предходно тримесечие (причината по мениджър) и опциите (PUT / CALL) — извън дългите позиции и % от портфейла #}
{% macro si_nocmp(st) %}{% if st and st.no_comparison %}<div class="data-note warn">⚠ 13F без сравнение с предходното тримесечие — нова/увеличена позиция, SI✓ и големите изходи не се показват за:
  {% for x in st.no_comparison %}{{ x.manager }} ({{ x.text }}){{ "; " if not loop.last else "." }}{% endfor %}</div>{% endif %}{% endmacro %}
{# 19.10.2026: тикърите по CUSIP — ред в секцията при грешка / недовършени и броят "без тикър" (празен отговор не е тиха липса) #}
{% macro si_cusip(st) %}{% set ct = (st or {}).get("cusip_tickers") or {} %}{% if ct.rows %}<div class="{{ 'data-note warn' if ct.error or ct.skipped else 'small' }}" style="font-size:12px;{{ '' if ct.error or ct.skipped else 'color:var(--muted);' }}margin-top:6px">{% if ct.error %}⚠ Тикърите по CUSIP (OpenFIGI) не се изтеглиха днес ({{ ct.error }}) — {% elif ct.skipped %}⚠ {{ ct.skipped }} CUSIP-а не стигнаха бюджета на run-а — {% else %}Тикърите: {% endif %}по CUSIP {{ ct.by_cusip }}, по име {{ ct.by_name }}, без тикър {{ ct.no_ticker }} от {{ ct.rows }} реда.</div>{% endif %}{% endmacro %}
{% macro si_opt_kind(label, k) %}{% if k and k.count %}{{ label }} {{ k.count }} ({{ k.value|money_short }}): {% for t in k.top %}<span title="CUSIP {{ t.cusip }}{% if t.figi_name %} · по CUSIP (OpenFIGI): {{ t.figi_name }}{% endif %} · в 13F: {{ t.company }}">{{ t.ticker or (t.company|cname(28, false)) }}</span> {{ t.value|money_short }}{{ ", " if not loop.last }}{% endfor %}{% if k.count > k.top|length %}, …{% endif %}{% endif %}{% endmacro %}
{% macro si_options(st) %}{% if st and st.options %}<div class="small" style="font-size:12px;color:var(--muted);margin-top:8px">Опции в 13F — не са дълги позиции и не влизат в % от портфейла (стойността е на базовия актив; тикърът е по CUSIP — името от 13F и CUSIP-ът са при посочване):
  {% for o in st.options %}<div style="margin-top:3px">{{ o.manager }} — {{ si_opt_kind("PUT", o.put) }}{% if o.put and o.put.count and o.call and o.call.count %}; {% endif %}{{ si_opt_kind("CALL", o.call) }}</div>{% endfor %}</div>{% endif %}{% endmacro %}
{% macro pct_cell(v) %}{% if v is none %}—{% else %}<span class="{{ 'neg' if v < 0 else 'pos' }}">{{ "%+.1f"|format(v) }}%</span>{% endif %}{% endmacro %}
{% macro ma_cell(v, days, need) %}{% if v is none %}{% if days and days < need %}<span class="na">&lt;{{ need }} дни</span>{% else %}—{% endif %}{% elif v %}<span class="pos">над</span>{% else %}<span class="neg">под</span>{% endif %}{% endmacro %}
{% macro ctx_meta(ctx_regime, sector) %}
        <div class="ctx-meta">Режим: <b>{{ ctx_regime }}</b> ·
          {% if sector.etf %}Сектор {{ sector.etf }}{% if sector.label %} ({{ sector.label }}){% endif %}:
            {% if sector.rs_4w is not none %}RS {{ pct_cell(sector.rs_4w) }} (4с) / {{ pct_cell(sector.rs_12w) }} (12с){% else %}няма данни{% endif %}{% if sector.laggard %} · <span class="neg">изоставащ</span>{% elif sector.leading %} · <span class="pos">водещ</span>{% endif %}
          {% else %}Сектор: —{% endif %}</div>
{% endmacro %}
{% macro ctx_table(rows) %}
        <table class="ctx-table">
          <tr><th>Тикър</th><th class="num">1 месец</th><th>50DMA</th><th>200DMA</th><th>Отчет</th><th>Статус</th></tr>
          {% for r in rows %}
          <tr><td class="mono">{{ r.ticker }}</td>
            {% if r.no_price_data %}<td colspan="3" class="neg">няма ценови данни</td>
            {% else %}<td class="num">{{ pct_cell(r.chg_1m_pct) }}</td><td>{{ ma_cell(r.above_50, r.history_days, 50) }}</td><td>{{ ma_cell(r.above_200, r.history_days, 200) }}</td>{% endif %}
            <td>{% if r.next_earnings %}<span class="{{ 'warn-txt' if r.earnings_soon else '' }}">{{ r.next_earnings[8:10] }}.{{ r.next_earnings[5:7] }} ({{ r.days_to_earnings }} дни)</span>{% else %}—{% endif %}</td>
            <td>{{ r.status or "—" }}</td></tr>
          {% endfor %}
        </table>
{% endmacro %}
{% macro thesis_context_box(ctx) %}
      <div class="thesis-ctx">
        <div class="ctx-title">Контекст · само данни</div>
        {# 08.10 (2в): тези с подгрупи (уран/добив срещу оператори) — по група собствен ориентир, обобщение и таблица #}
        {% if ctx.groups %}
        {% for g in ctx.groups %}
        <div class="ctx-group">
          <div class="ctx-group-name">{{ g.name }}</div>
          <div class="ctx-summary">{{ g.summary }}</div>
          {{ ctx_meta(ctx.regime, g.sector) }}
          {{ ctx_table(g.rows) }}
        </div>
        {% endfor %}
        {% else %}
        <div class="ctx-summary">{{ ctx.summary }}</div>
        {{ ctx_meta(ctx.regime, ctx.sector) }}
        {{ ctx_table(ctx.rows) }}
        {% endif %}
      </div>
{% endmacro %}

{% if theses %}
<section>
  <h2>Геополитически тези · мониторинг</h2>
  <div class="theses">
    {% for th in theses %}
    <div class="thesis {{ th.status }}">
      <div class="thesis-head">
        <span class="thesis-name">{{ th.name }}</span>
        <span class="thesis-status {{ th.status }}">{{ "активна" if th.status == "active" else "структурна" if th.status == "structural" else "наблюдава се" }}</span>
        {% if th.overdue_text %}<span class="thesis-status watch" style="color:var(--yellow)" title="Срокът за преглед беше {{ th.review_by }}">⚠ {{ th.overdue_text }}</span>{% endif %}
        {# 19.10.2026 (т. 10, решение "в"): без AI етикети ("потвърдена / опровергана от новина", "друг път", "разрешена") и без бележката на модела #}
      </div>
      <div class="thesis-tickers">{{ th.tickers|join("  ·  ") }}</div>
      <div class="thesis-chain">{{ th.chain }}</div>
      {% for n in th.news_headlines or [] %}<div class="thesis-headline">📰 {{ n.headline }}{% if n.source %} <span style="color:var(--muted)">· {{ n.source }}</span>{% endif %}</div>{% endfor %}
      {% if th.trigger_reason %}<div class="thesis-trigger">▲ Тригер активен: {{ th.trigger_reason }}</div>{% endif %}
      {% if th.missing_price %}<div class="thesis-missing">⚠ Няма ценови данни за {{ th.missing_price|join(", ") }} — вероятно делистнат или сменен тикър; провери списъка в config.py.</div>{% endif %}
      {% if th.context %}{{ thesis_context_box(th.context) }}{% endif %}
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% macro earnings_icon(modal_id, recap) %}
{% if recap %}
<span class="earn-icon earn-{{ recap.quality or 'na' }}" data-modal="{{ modal_id }}"
      title="Earnings recap — кликни за детайли" role="button" tabindex="0">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
       stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M3 13a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v6a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -6" />
    <path d="M15 9a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -10" />
    <path d="M9 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -14" />
    <path d="M4 20h14" />
  </svg>
</span>
{% endif %}
{% endmacro %}

{% macro earnings_pct_cell(v, extra) %}{% if v is not none %}{{ '+' if v >= 0 else '' }}{{ v }}%{{ extra }}{% else %}—{% endif %}{% endmacro %}

{% macro earnings_row(q, yoy) %}
<tr class="{{ 'earn-yoy-row' if yoy else '' }}">
  <td>{{ q.date }}{% if yoy %} <span class="earn-yoy-label">(YoY база)</span>{% endif %}</td>
  <td>{{ q.eps_actual if q.eps_actual is not none else "—" }}{% if q.eps_estimate is not none %} / {{ q.eps_estimate }} est.{% endif %}</td>
  <td class="{{ 'earn-pos' if q.eps_surprise_pct is not none and q.eps_surprise_pct >= 0 else 'earn-neg' if q.eps_surprise_pct is not none else '' }}">{{ earnings_pct_cell(q.eps_surprise_pct, '') }}</td>
  <td class="{{ 'earn-pos' if q.reaction_pct is not none and q.reaction_pct >= 0 else 'earn-neg' if q.reaction_pct is not none else '' }}">{{ earnings_pct_cell(q.reaction_pct, ' (' ~ q.reaction_volume_ratio ~ 'x)' if q.reaction_volume_ratio is not none else '') }}</td>
</tr>
{% endmacro %}

{% macro earnings_modal(modal_id, recap) %}
{% if recap %}
<div class="earn-modal" id="{{ modal_id }}" hidden>
  <div class="earn-modal-content">
    <button class="earn-modal-close" type="button" aria-label="Затвори">×</button>
    <h3>Earnings История</h3>
    <table class="earn-table">
      <thead><tr><th>Тримесечие</th><th>EPS факт/оч.</th><th>Изненада</th><th>Реакция</th></tr></thead>
      <tbody>
        {% for q in recap.quarters %}{{ earnings_row(q, false) }}{% endfor %}
        {% if recap.yoy %}{{ earnings_row(recap.yoy, true) }}{% endif %}
      </tbody>
    </table>
    {% if recap.yoy_summary %}
    <p class="earn-yoy-summary">{{ recap.yoy_summary.current_date }} срещу {{ recap.yoy_summary.yoy_date }}
      (тримесечен ръст г/г, не годишен тотал): EPS {{ recap.yoy_summary.eps_current }} vs {{ recap.yoy_summary.eps_yoy }}
      — {{ earnings_pct_cell(recap.yoy_summary.yoy_growth_pct, '') }}</p>
    {% endif %}
    {% if recap.forward %}
    <h3>Следващ отчет</h3>
    <div class="kv"><span>Дата</span><b>{{ recap.forward.next_earnings }} ({{ recap.forward.days_to_earnings }}д)
      {%- if recap.forward.in_blackout %} · blackout{% endif %}</b></div>
    {% if recap.forward.consensus_eps is not none %}
    <div class="kv"><span>Консенсус EPS</span><b>{{ recap.forward.consensus_eps }}
      {%- if recap.forward.expected_growth_pct is not none %} (спрямо {{ recap.forward.yoy_date }}:
      {{ earnings_pct_cell(recap.forward.expected_growth_pct, '') }} очакван г/г ръст){% endif %}</b></div>
    {% endif %}
    {% endif %}
  </div>
</div>
{% endif %}
{% endmacro %}

<section>
  <h2>Action · {{ action|length }} тикъра</h2>
  {% for st in action %}
  {% set p = st.plan %}
  {% set earn_modal_id = "earn-modal-action-" ~ st.ticker %}
  <div class="stock-card">
    <div class="stock-head">
      <div><span class="ticker">{{ st.ticker }}</span><span class="company">{{ st.company|cname }} · {{ st.sector }}</span>
        {{ markers_html(st.markers) }}
        {{ earnings_icon(earn_modal_id, st.earnings.recap) }}
      </div>
      <div class="price-tag">${{ st.price }} <span style="color:var(--muted);font-size:13px">pivot ${{ st.pivot }} ({{ st.pct_from_pivot }}%)</span></div>
    </div>
    {% if st.prev_position %}
    <div class="re-entry">↻ Предишна позиция от {{ st.prev_position.entry_date }} приключи на
      {{ st.prev_position.resolution_date }} ({{ st.prev_position.outcome }}{% if st.prev_position.realized_r is not none %},
      {{ "%+.1f"|format(st.prev_position.realized_r) }}R{% endif %}).
      Това е <strong>нов вход</strong>, не продължение на старата теза.</div>
    {% endif %}
    {% if st.earnings_warning %}<div class="earn-warn">{{ st.earnings_warning.text }}</div>{% endif %}
    {% if st.corp_action %}<div class="corp-warn">{{ st.corp_action.text }}</div>{% endif %}
    {% if st.get("spinoff_warning") %}<div class="corp-warn">{{ st.spinoff_warning.text }}</div>{% endif %}{% if st.get("merger_target") %}<div class="corp-warn">{{ st.merger_target.text }}</div>{% endif %}
    {% for n in st.cot_notes or [] %}<div class="cot-note">{{ n.text }}</div>{% endfor %}
    {% if st.setup and st.setup.book_note %}<div class="small" style="font-size:12.5px;color:var(--muted);margin:4px 0">{{ st.setup.book_note }}</div>{% endif %}
    <div class="stock-body">
      <div class="block">
        <h3>Защо точно сега</h3>
        <div class="why">{{ st.ai.why_now }}</div>
        <h3>Бизнес</h3>
        <div class="why">{{ st.ai.business_bg }}</div>
        <h3>Катализатори · 4–8 седмици</h3>
        <ul class="tight">{% for c in st.ai.catalysts %}<li>{{ c }}</li>{% endfor %}</ul>
        <h3>Рискове</h3>
        <ul class="tight">{% for r in st.ai.risks %}<li>{{ r }}</li>{% endfor %}</ul>
        {% if st.ai.warning %}<p class="warn">⚠ {{ st.ai.warning }}</p>{% endif %}
        <h3>Short Interest</h3>
        <div class="why" style="font-size:13.5px">{{ st.short_view.interpretation }}</div>
      </div>
      <div class="block">
        <h3>Техническа картина</h3>
        <div class="kv"><span>База (13 седмици)</span><b>{{ st.base_type }}</b></div>
        <div class="kv"><span>Weinstein Stage</span><b>{{ st.weinstein_stage }}</b></div>
        <div class="kv"><span>RS Line</span><b>{{ "нов максимум" if st.rs_status == "new_high" else "близо до максимум" }}{% if st.rs_held %} <span title="Влиза от 97% от 52-седмичния максимум на RS линията и остава до 94% (хистерезис, 09.10) — по-малко мигане на списъка" style="font-weight:400;color:var(--yellow)">· {{ "%.1f"|format(st.rs_line_pct) }}% от макс. (задържан)</span>{% endif %}</b></div>
        {# FIX 2026-10-03 (пакет 1, т.9): RS rating = перцентил на претеглената 12-месечна доходност в универса #}
        {% if st.rs_rating is not none and st.rs_rating is defined %}<div class="kv"><span>RS rating (перцентил)</span><b>{{ st.rs_rating }}</b></div>{% endif %}
        {% if st.pct_above_52w_low is defined %}<div class="kv"><span>52-седмичен диапазон</span><b>+{{ st.pct_above_52w_low }}% над дъното · −{{ st.pct_below_52w_high }}% под върха</b></div>{% endif %}
        <div class="kv"><span>50DMA / 200DMA</span><b>${{ st.ma50 }} / ${{ st.ma200 }}</b></div>
        {# 22.10.2026 (етап 4): „пробивен“ само над pivot — флагът е само обем ≥ 1.5× (ROKU 22.10: 3.5x при −1.32% под pivot) #}
        <div class="kv"><span>Обем (vs 50d avg)</span><b>{{ st.volume_ratio }}x{% if st.breakout_volume %}{{ " ✓ пробивен" if (st.pct_from_pivot or 0) >= 0 else " · над 1.5× средния, без пробив (под pivot)" }}{% endif %}</b></div>
        {% if st.entry_timing %}
        <div class="kv"><span>Entry Timing</span>
          <b style="color: {{ 'var(--green)' if st.entry_timing.verdict == 'good' else 'var(--red)' if st.entry_timing.verdict == 'wait' else 'var(--yellow)' }}">
            {{ 'Добър timing' if st.entry_timing.verdict == 'good' else 'Изчакай' if st.entry_timing.verdict == 'wait' else 'Внимание' }}
          </b>
        </div>
        <div class="why" style="font-size:12.5px;color:var(--muted);margin-top:2px">{{ st.entry_timing.note }}</div>
        {% endif %}
        <h3>Фундамент</h3>
        {# 26.10.2026 (решение по етап 4б, т. 2): основното число е EPS ОТ ОТЧЕТА (последното тримесечие срещу година по-рано); earningsQuarterlyGrowth на Yahoo е ръстът на НЕТНАТА
           ПЕЧАЛБА — само с изричен етикет (AMG 26.10: нетна печалба +120.5%, EPS от отчета +53.8%) #}
        {% set er = (st.earnings or {}).get("eps_report_yoy") or ((((st.earnings or {}).get("recap") or {}).get("yoy_summary")) and {"pct": st.earnings.recap.yoy_summary.yoy_growth_pct, "current": st.earnings.recap.yoy_summary.eps_current, "yoy": st.earnings.recap.yoy_summary.eps_yoy, "date": st.earnings.recap.yoy_summary.current_date, "yoy_date": st.earnings.recap.yoy_summary.yoy_date}) %}
        <div class="kv"><span>EPS ръст (от отчета)</span><b>{% if er and er.pct is not none %}{{ "%+.1f"|format(er.pct) }}% <span style="font-weight:400;color:var(--muted)">(EPS ${{ er.current }} срещу ${{ er.yoy }}, {{ er.date[8:10] }}.{{ er.date[5:7] }} г/г)</span>{% else %}—{% endif %}</b></div>
        {% if st.eps_growth_yoy is defined and st.eps_growth_yoy is not none %}<div class="kv"><span title="earningsQuarterlyGrowth на Yahoo: нетната печалба на последното тримесечие срещу година по-рано — не е EPS от отчета">Ръст на нетната печалба (Yahoo, тримесечие г/г)</span><b>{{ "%+.1f"|format(st.eps_growth_yoy) }}%</b></div>{% endif %}
        <div class="kv"><span>Revenue ръст YoY</span><b>{{ st.revenue_growth_yoy }}%</b></div>
        <div class="kv"><span>ROE</span><b>{{ st.roe }}%</b></div>
        <div class="kv"><span>P/E / Fwd P/E</span><b>{{ st.pe|round(1) if st.pe else "—" }} / {{ st.forward_pe|round(1) if st.forward_pe else "—" }}</b></div>
        <div class="kv"><span>Inst. ownership</span><b>{{ st.inst_ownership_pct }}%</b></div>
        <h3>Earnings</h3>
        <div class="kv"><span>Следващ отчет</span><b>{{ st.earnings.next_earnings or "—" }}{% if st.earnings.days_to_earnings is not none %} ({{ st.earnings.days_to_earnings }}д){% endif %}</b></div>
        {# 19.10.2026 (етап 2, т. 11): текстът е на модела — не е "Препоръка"; датата и предупреждението за отчета са от кода (earnings_warning) #}
        {% if st.ai.earnings_call %}<div class="kv"><span title="Текстът е на модела, не е препоръка; датата и предупреждението за отчета горе са от кода">Бележка на AI за отчета</span><b>{{ st.ai.earnings_call }}</b></div>{% endif %}
        <div class="plan">
          <h3 style="color:var(--regime)">План{% if p.sizing_factor < 1 %} · режимен фактор ×{{ p.sizing_factor }} (Defensive){% endif %}</h3>
          {# FIX 2026-10-03 (пакет 1, т.3): v2 план — buy-stop на pivot с таван за вход,
             структурен стоп с процент, цел 1 е за половината позиция #}
          {% if p.method == 'v2' %}
          <div class="kv"><span>Вход (buy-stop)</span><b>${{ p.buy_stop }} · таван ${{ p.max_chase }}</b></div>
          <div class="kv"><span>Валиден до</span><b>{{ p.valid_through[8:10] ~ '.' ~ p.valid_through[5:7] if p.valid_through else '—' }} ({{ p.window_sessions }} сесии)</b></div>
          {% else %}
          <div class="kv"><span>Entry</span><b>${{ p.entry_range[0] }} – ${{ p.entry_range[1] }}</b></div>
          {% endif %}
          {% if not st.levels %}<div class="kv"><span>Stop ({{ p.stop_basis }})</span><b>${{ p.stop_loss }}{% if p.risk_pct %} (−{{ p.risk_pct }}%){% endif %}</b></div>{% endif %}
          <div class="kv"><span>Цел 1 (2:1){% if p.method == 'v2' %} · {{ (p.target_1_fraction * 100)|round|int }}% от позицията{% endif %}</span><b>${{ p.target_1 }}</b></div>
          <div class="kv"><span>Цел 2</span><b style="font-size:11.5px">{{ p.target_2 }}</b></div>
          <div class="kv"><span>Хоризонт</span><b>{{ p.time_horizon }}</b></div>
          {% if p.method == 'v2' %}
          <div class="why" style="font-size:12px;color:var(--muted);margin-top:6px">Референтният вход е ≈ ${{ p.entry_mid }} (сигналният close); ако отвори по-високо, риск/акция = цена − ${{ p.stop_loss }} — въведи реалния вход с „коригирай“.</div>
          {% endif %}
          {{ levels_block(st.levels) }}
        </div>
      </div>
    </div>
  </div>
  {{ earnings_modal(earn_modal_id, st.earnings.recap) }}
  {% else %}
  {% if data_warnings and data_warnings|selectattr('source', 'equalto', 'screener')|selectattr('level', 'equalto', 'error')|list %}
  <div class="prose">Скринингът днес не се изпълни (липсват данни — виж предупреждението най-горе). Празният списък НЕ значи, че няма сетъпи.</div>
  {% else %}
  <div class="prose">Днес нито един кандидат не покрива всички критерии за Action. Това е информация, не провал — кешът също е позиция.</div>
  {% endif %}
  {% endfor %}
</section>

{% if correlation_flags %}
<div class="prose" style="border-left-color: var(--yellow); margin-top: 16px">
  <b>⚠ Корелационен риск:</b>
  {% for f in correlation_flags %}
  {{ f.tickers[0] }} ↔ {{ f.tickers[1] }} (корелация {{ f.correlation }}){{ ", " if not loop.last else "" }}
  {% endfor %}
  — движат се силно синхронно; обмисли намалена експозиция в единия при
  едновременно държане на двата.
</div>
{% endif %}

{# 13.10.2026: изключени заради корпоративно действие с нецял коефициент (отделяне) — ред под секцията; текстът е от кода (corp_actions.exclusion_text) #}
{% macro corp_excluded_line(rows) %}{% if rows %}<div class="small corp-excluded" style="font-size:12.5px;color:var(--yellow);margin:0 0 10px"><b>Изключени (корпоративно действие):</b>
  {% for e in rows %}{{ e.text }}{{ " · " if not loop.last else "" }}{% endfor %}</div>{% endif %}{% endmacro %}
<section>
  <h2>Watchlist · {{ watchlist|length }}{% if watchlist_compact %} <span style="font-size:13px;color:var(--muted);font-weight:400">(+{{ watchlist_compact|length }} без сетъп за вход)</span>{% endif %}</h2>
  {{ corp_excluded_line(corp_excluded.get("screener")) }}
  {# 09.10: "Излязоха от вчера" — тикърите от предишния Watchlist, които днес ги няма, с причината от кода (само информация) #}
  {% if watchlist_exits and watchlist_exits.get("from") %}
  <div class="small" style="font-size:12.5px;color:var(--muted);margin:0 0 10px"><b>Излязоха от {{ watchlist_exits_label }}:</b>
    {% for r in watchlist_exits.get("rows", []) %}<b>{{ r.ticker }}</b>: {{ r.reason }}{% if r.yesterday %} <span style="opacity:.8">(вчера: {{ r.yesterday }})</span>{% endif %}{{ " · " if not loop.last else "" }}{% else %}няма{% endfor %}
  </div>
  {% endif %}
  {# опростяване (втори преглед, 10.10.2026): too_wide / extended / no_volume — един ред, причината и стопът от кода, без AI наратив #}
  {% if watchlist_compact %}
  <div class="small" style="font-size:12.5px;color:var(--muted);margin:0 0 12px"><b>В скрийнъра, без сетъп за вход днес:</b>
    {% for r in watchlist_compact %}<b>{{ r.ticker }}</b> — {{ r.reason }}{% if r.kind != 'too_wide' and r.stop_pct is not none %}, стоп {{ "%.1f"|format(r.stop_pct) }}%{% endif %}{% if r.earnings %}, отчет {{ r.earnings.date[8:10] }}.{{ r.earnings.date[5:7] }}{% if r.earnings.pct is not none %} (±{{ r.earnings.pct }}%){% endif %}{% endif %}{% if r.markers %} {{ r.markers|map(attribute='tag')|join(' ') }}{% endif %}{% if r.spinoff %}, <span style="color:var(--yellow)">⚠ отделяне {{ r.spinoff.distribution[8:10] }}.{{ r.spinoff.distribution[5:7] }} (запис {{ r.spinoff.record[8:10] }}.{{ r.spinoff.record[5:7] }})</span>{% endif %}{% if r.merger %}, <span style="color:var(--yellow)">⚠ цел на придобиване ({{ r.merger.buyer }}, {{ r.merger.announced[8:10] }}.{{ r.merger.announced[5:7] }}.{{ r.merger.announced[:4] }})</span>{% endif %}{{ " · " if not loop.last else "" }}{% endfor %}
  </div>
  {% endif %}
  <div class="watch-grid">
    {% for st in watchlist %}
    <div class="watch-card">
      <span class="ticker">{{ st.ticker }}</span>
      <span class="company">{{ st.company|cname }}</span>
      {% if st.rs_rating is defined and st.rs_rating is not none %}<span class="rs-badge" title="RS rating — перцентил на претеглената 12-месечна доходност в универса">RS {{ st.rs_rating }}</span>{% endif %}
      {{ markers_html(st.markers) }}
      {# FIX 2026-09-23: маркерът RE-ENTRY пътува и до Watchlist картите
         (слага се в apply_hard_rules ПРЕДИ класификацията), но обясняващият ред
         беше само в Action шаблона — FTNT на 23.09 показа таг без обяснение. #}
      {% if st.prev_position %}
      <div class="re-entry" style="margin:6px 0 4px">↻ Предишна позиция от {{ st.prev_position.entry_date }}
        приключи на {{ st.prev_position.resolution_date }} ({{ st.prev_position.outcome }}{% if st.prev_position.realized_r is not none %},
        {{ "%+.1f"|format(st.prev_position.realized_r) }}R{% endif %}).</div>
      {% endif %}
      {% if st.earnings_warning %}<div class="earn-warn">{{ st.earnings_warning.text }}</div>{% endif %}
      {% if st.corp_action %}<div class="corp-warn">{{ st.corp_action.text }}</div>{% endif %}
      {% if st.get("spinoff_warning") %}<div class="corp-warn">{{ st.spinoff_warning.text }}</div>{% endif %}{% if st.get("merger_target") %}<div class="corp-warn">{{ st.merger_target.text }}</div>{% endif %}
      {% for n in st.cot_notes or [] %}<div class="cot-note">{{ n.text }}</div>{% endfor %}
      {# 12.10: потвърден пробив с жив запис в buy-stop книгата — неутрален ред (без "не нов вход") #}
      {% if st.setup and st.setup.book_note %}<div class="small" style="font-size:12.5px;color:var(--muted);margin:4px 0">{{ st.setup.book_note }}</div>{% endif %}
      <p>{{ st.ai.why_now }}</p>
      {# 07.10: жив запис в книгата, задействан (open/trailing) — картата казва изпълнения сигнал, не "чака пробив" #}
      {% if not (st.setup and st.setup.triggered) %}
      <div class="watch-trigger"><b>Trigger:</b> {{ st.ai.watchlist_trigger }}
        · pivot ${{ st.pivot }} ({{ "%+.1f"|format(st.pct_from_pivot) }}%)</div>
      {% endif %}
      {# FIX 2026-10-02 (пакет 1, т.1): код-изчислен сетъп — buy-stop ниво за кандидатите
         под pivot; за останалите (над pivot без обем / extended) — причината от кода #}
      {# 19.10.2026: задействан запис — текстът на книгата е долу (зелен); "Сетъп:" го повтаряше (EXPD 19.10) #}
      {% if st.setup and not st.setup.triggered and st.ai.watchlist_reason_type != 'technical_gate' and st.setup.trigger_text not in (st.ai.watchlist_trigger or '') %}
      <div class="watch-trigger"><b>Сетъп:</b> {{ st.setup.trigger_text }}</div>
      {% endif %}
      {% if st.setup and st.setup.triggered %}
      <div class="buy-stop" style="color:var(--green)">{{ st.setup.trigger_text }}</div>
      {% elif st.setup and st.setup.buy_stop %}
      <div class="buy-stop">🎯 Buy-stop ${{ "%.2f"|format(st.setup.buy_stop) }} · валиден {{ st.setup.valid_label or ('до ' ~ (st.setup.valid_through[8:10] ~ '.' ~ st.setup.valid_through[5:7] if st.setup.valid_through else '—')) }}
        · таван за вход ${{ "%.2f"|format(st.setup.max_chase) }}</div>
      {# пакет 2: план при задействане — стоп, риск %, цел 1 (2R) и размер при sizing-а на режима, като при Action картата #}
      {% set pp = st.plan_preview %}
      {% if pp and pp.valid %}
      <div class="buy-stop" style="margin-top:4px">📐 Ако се задейства:
        {% if not st.levels %}вход ≈ ${{ "%.2f"|format(pp.entry_mid) }} · Stop ${{ "%.2f"|format(pp.stop_loss) }} (−{{ pp.risk_pct }}%) · {% endif %}Цел 1 (2R, {{ (pp.target_1_fraction * 100)|round|int }}% от позицията) ${{ "%.2f"|format(pp.target_1) }}
        {% if pp.sizing_factor < 1 %}· режимен фактор {{ regime }} ×{{ pp.sizing_factor }}{% endif %}{% if regime == 'Cash' %} · режим Cash: нов Action не се дава, планът е само ориентир{% endif %}</div>
      {% set bpn = book_plan_note(st.setup, pp, st.levels) %}{% if bpn %}<div class="lv-note" style="margin-top:4px">{{ bpn }}</div>{% endif %}
      {{ levels_block(st.levels) }}
      {% endif %}
      {% endif %}
    </div>
    {% endfor %}
  </div>
</section>

{% if backtest and (backtest.total_resolved or backtest.open_positions or backtest.pending_positions or backtest.v1_archive) %}
<section>
  {# 19.10.2026 (трети преглед, т. 18в): книгите на CANSLIM — веднага под Watchlist, сгънати (като книгата на Kullamägi под картите му) #}
  <details class="canslim-book">
  <summary>
  {# 08.10: заглавието казва колко Action сигнала са записани от старта — "0 резолвирани" без това изглежда като празна система, а сигнали може да чакат buy-stop или да не са се задействали #}
  <h2>Track Record v2 · {% if backtest.action_signals is defined %}{{ backtest.action_signals }} Action {{ "сигнал" if backtest.action_signals == 1 else "сигнала" }}{% if backtest.methodology and backtest.methodology.switched_on %} от {{ backtest.methodology.switched_on[8:10] }}.{{ backtest.methodology.switched_on[5:7] }}{% endif %} · {% endif %}{{ backtest.total_resolved }} резолвирани</h2>
  <span class="book-hint">книга Action · измерване — разгъни</span>
  </summary>
  {# FIX 2026-10-03 (пакет 1, т.7): чист старт — v1 е архив, един ред #}
  {% if backtest.v1_archive %}
  <div class="small" style="font-size:12.5px;color:var(--muted);margin:0 0 8px">
    v1 методология: n={{ backtest.v1_archive.n }}, win rate {{ backtest.v1_archive.win_rate_pct }}%,
    среден R {{ backtest.v1_archive.avg_r }}{% if backtest.v1_archive.unpriced %} ({{ backtest.v1_archive.unpriced }} без цена){% endif %}{% if backtest.v1_archive.expired_mtm %} ({{ backtest.v1_archive.expired_mtm }} изтекли — оценени по Close при изтичането){% endif %}{% if backtest.v1_archive.expired_no_r %} ({{ backtest.v1_archive.expired_no_r }} изтекли без R, извън n){% endif %}
    · архивирана на {{ backtest.methodology.switched_on }} (отворените v1 позиции затворени по последния Close, mark-to-market);
    Track Record v2 започва от нула.</div>
  {% endif %}
  <div class="prose">
    {# пакет 2 (05.10): без нито една резолвирана v2 сделка няма win rate — "0.0% (0 win / 0 loss)" би се четало като измерен резултат #}
    {% if not backtest.total_resolved %}
    <b>Още няма затворени сделки по v2</b> — win rate и среден R се показват от първата резолюция.<br>
    {% else %}
    {# С4 (10.10.2026): win rate и win/loss чак при ≥ min_closed затворени, както другите книги; стар бриф без полето — както преди #}
    {% if backtest.stats_visible is not defined or backtest.stats_visible %}
    <b>Win rate: {{ backtest.win_rate_pct }}%</b> ({{ backtest.wins }} win / {{ backtest.losses }} loss)<br>
    {% else %}
    <b>Затворени: {{ backtest.total_resolved }}</b> — win rate и сравнението със SPY се показват при ≥ {{ backtest.min_closed }} затворени (дотогава броят и средният R).<br>
    {% endif %}
    {{ backtest.stopped }} стоп{% if backtest.stopped_after_partial %} (от тях {{ backtest.stopped_after_partial }} след частична продажба){% endif %}
    / {{ backtest.trailing_stop_exit }} trailing-exit / {{ backtest.expired_in_trail }} expired-in-trail
    / {{ backtest.expired }} expired (оценени по последния Close, mark-to-market)<br>
    {% endif %}
    {# FIX 2026-10-03 (пакет 1, т.4): 50% се продава на цел 1 (2R), остатъкът е в trailing #}
    Все още отворени: {{ backtest.still_open }} (преди цел 1) + {{ backtest.trailing }} (след частична продажба на цел 1, trailing)<br>
    {# FIX 2026-10-03 (пакет 1, т.2): buy-stop входове — не са позиции и не влизат в статистиката #}
    Чакат buy-stop: {{ backtest.pending or 0 }} · не се задействаха: {{ backtest.not_triggered or 0 }}{% if backtest.skipped_extended %}
    · над тавана за вход: {{ backtest.skipped_extended }}{% endif %} (извън статистиката)<br>
    {% if backtest.total_resolved %}Среден реализиран R: {{ backtest.avg_realized_r }}{% endif %}
    {# FIX 2026-10-03 (пакет 1, т.8): същият капитал в SPY за СЪЩИТЕ периоди на държане #}
    {% if backtest.spy_compare %}<br>Спрямо SPY (същите периоди на държане, {{ backtest.spy_compare.n }} затворени):
    средно {{ "%+.2f"|format(backtest.spy_compare.avg_return_pct) }}% срещу SPY {{ "%+.2f"|format(backtest.spy_compare.avg_spy_pct) }}%
    → разлика {{ "%+.2f"|format(backtest.spy_compare.avg_alpha_pct) }}%
    · {{ backtest.spy_compare.beat_spy_pct }}% от позициите водят SPY{% endif %}
  </div>
  {% if backtest.pending_positions %}
  <div class="small" style="font-size:12px;color:var(--muted);margin-top:14px">Чакат buy-stop ({{ backtest.pending_positions|length }}):</div>
  <div class="card" style="padding:6px 4px;margin-top:6px">
    <table class="pos-table">
      <thead><tr><th>Тикър</th><th>Препоръка</th><th class="n">Buy-stop</th><th class="n">Таван</th>
        <th class="n">Стоп</th><th>Валиден до</th></tr></thead>
      <tbody>
        {% for p in backtest.pending_positions %}
        <tr><td class="sym">{{ p.ticker }}{{ markers_html(p.markers) }}{{ spinoff_note_html(p) }}</td><td>{{ p.entry_date }}</td><td class="n">${{ p.buy_stop }}</td>
          <td class="n">${{ p.max_chase }}</td><td class="n">${{ p.stop_loss }}</td><td>{{ p.valid_through or "—" }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
  {% if backtest.recent %}
  <div class="small" style="font-size:12px;color:var(--muted);margin-top:14px">Резолюции тази седмица:</div>
  <div class="watch-grid" style="margin-top:6px">
    {% for r in backtest.recent %}
    <div class="watch-card">
      <span class="ticker" style="color: {{ 'var(--green)' if r.realized_r and r.realized_r > 0 else 'var(--red)' if r.realized_r and r.realized_r <= 0 else 'var(--muted)' }}">{{ r.ticker }}</span>
      <p>{{ r.entry_date }} → {{ r.resolution_date }} · {{ r.resolution }}
      {% if r.realized_r is not none %} · R={{ r.realized_r }}{% endif %}
      {% if r.late_discovery %} · <span style="color:var(--muted)">открито със закъснение</span>{% endif %}</p>
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {{ entry_vol_line(backtest.entry_volume) }}
  {{ events_line(backtest.events, "R") }}
  {% if backtest.open_positions %}
  <div class="small" style="font-size:12px;color:var(--muted);margin-top:14px">Отворени позиции ({{ backtest.open_positions|length }}):</div>
  <div class="card" style="padding:6px 4px;margin-top:6px">
    <table class="pos-table">
      <thead><tr><th>Тикър</th><th>Дата на вход</th><th class="n">Entry цена</th>
        <th class="n">Текуща цена</th><th class="n">% промяна</th><th class="n">SPY, същия период</th></tr></thead>
      <tbody>
        {% for p in backtest.open_positions[:100] %}
        {% set track_modal_id = "earn-modal-track-" ~ p.ticker ~ "-" ~ p.entry_date %}
        <tr class="{{ 'pos-row-up' if p.unrealized_pct and p.unrealized_pct >= 0 else 'pos-row-down' if p.unrealized_pct and p.unrealized_pct < 0 else '' }}">
          <td class="sym">{{ p.ticker }}{{ earnings_icon(track_modal_id, p.earnings_recap) }}{{ markers_html(p.markers) }}{{ spinoff_note_html(p) }}</td>
          <td>{{ p.entry_date }}{% if p.entry_volume_ratio is defined and p.entry_volume_ratio is not none %} <span style="color:var(--muted);font-size:11.5px" title="Обемът на деня на входа спрямо средния за 50 бара — buy-stop се изпълнява при докосване, обемът се вижда при затварянето">(обем {{ "%.2f"|format(p.entry_volume_ratio) }}×)</span>{% endif %}</td>
          <td class="n">${{ p.entry_price }}</td>
          <td class="n">{{ "$" + p.current_price|string if p.current_price is not none else "н/д" }}</td>
          {% if p.needs_manual_review %}
          <td class="n pct" style="color:var(--yellow)"
              title="{{ p.needs_manual_review.reason }} · {% if p.needs_manual_review.reason == 'spin_off_after_entry' %}отделяне, коефициент {{ p.needs_manual_review.split_ratio }}{% else %}{{ p.needs_manual_review.split_ratio|int }}:1 split{% endif %} на {{ p.needs_manual_review.split_date }}">
            ⚠ {{ "отделяне" if p.needs_manual_review.reason == 'spin_off_after_entry' else "split" }} — нужен ръчен преглед{% if p.needs_manual_review.frozen_days is defined %}
            · замразена от {{ p.needs_manual_review.frozen_days }} дни{% endif %}
          </td>
          {% else %}
          <td class="n pct">{% if p.unrealized_pct is not none %}{{ '+' if p.unrealized_pct >= 0 else '' }}{{ p.unrealized_pct }}%{% else %}—{% endif %}</td>
          {% endif %}
          <td class="n pct">{% if p.spy_return_pct is defined and p.spy_return_pct is not none %}{{ "%+.1f"|format(p.spy_return_pct) }}%{% else %}—{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% for p in backtest.open_positions[:100] %}
  {{ earnings_modal("earn-modal-track-" ~ p.ticker ~ "-" ~ p.entry_date, p.earnings_recap) }}
  {% endfor %}
  {% if backtest.open_positions|length > 100 %}
  <div class="small" style="font-size:12px;color:var(--muted);margin-top:8px">
    и още {{ backtest.open_positions|length - 100 }} позиции
  </div>
  {% endif %}
  {% endif %}
  </details>
</section>
{% endif %}

{# Пакет 1б (05.10): buy-stop кандидатите (Watchlist) — ОТДЕЛНА книга, измерване, не препоръка; не е позиция и не се слива с Action #}
{% if backtest and backtest.buystop and backtest.buystop.enabled %}
{% set bs = backtest.buystop %}
{% set bs_res = {"stopped": "стоп", "trailing_stop_exit": "trailing изход", "expired": "изтекла по време", "expired_in_trail": "изтекла в trail"} %}
{% set bs_st = {"pending": "чака buy-stop", "open": "отворена", "trailing": "след цел 1 (trailing)"} %}
<section>
  <details class="canslim-book">
  <summary>
  <h2>Buy-stop кандидати — измерване, не препоръка</h2>
  <span class="book-hint">книга buy-stop · записани {{ bs.records if bs.records is defined else "—" }} — разгъни</span>
  </summary>
  <div class="small" style="font-size:12.5px;color:var(--muted);margin:0 0 8px">
    Watchlist карти под pivot с buy-stop, следени със същия модел на изпълнение като Action (вход при High ≥ buy-stop в рамките на
    {{ buy_stop_window }} сесии, по max(Open, buy-stop), не над +{{ buyable_zone_pct|round(0)|int }}%; стоп и цел от картата) във всички режими.
    Отделна книга: един и същ тикър може да е и в двете (отметка „и Action“), статистиките не се сумират. Не са позиции и не са съвет за покупка.</div>
  <div class="prose">
    {% if not bs.records %}
    <b>Още няма записани кандидати</b> — записват се Watchlist карти с buy-stop и валиден план.<br>
    {% else %}
    <b>Записани: {{ bs.records }}</b> · чакат buy-stop {{ bs.pending }} · отворени {{ bs.open }} · затворени {{ bs.closed }}
    · не се задействаха {{ bs.not_triggered }}{% if bs.not_triggered_pct is not none %} ({{ bs.not_triggered_pct }}% от приключилите прозорци){% endif %}{% if bs.skipped %}
    · над тавана за вход {{ bs.skipped }}{% endif %}{% if bs.also_action %} · и в Action: {{ bs.also_action }}{% endif %}<br>
    {% if bs.needs_review %}<span style="color:var(--yellow)">⚠ {{ bs.needs_review }} запис(а) с отделяне след входа — не се коригират като сплит, нужен е ръчен преглед.</span><br>{% endif %}
    {% if bs.closed %}Затворени: {{ bs.closed }} · среден R: {{ "%+.2f"|format(bs.avg_realized_r) }}<br>{% endif %}
    {% if bs.stats_visible %}
    <b>Win rate: {{ bs.win_rate_pct }}%</b> ({{ bs.wins }} win / {{ bs.losses }} loss; 95% интервал {{ bs.win_ci_pct[0] }}–{{ bs.win_ci_pct[1] }}%)
    · медиана R {{ "%+.2f"|format(bs.median_realized_r) }}<br>
    {% if bs.spy_compare %}Спрямо SPY (същите периоди, {{ bs.spy_compare.n }} затворени): средно {{ "%+.2f"|format(bs.spy_compare.avg_return_pct) }}%
    срещу SPY {{ "%+.2f"|format(bs.spy_compare.avg_spy_pct) }}% → разлика {{ "%+.2f"|format(bs.spy_compare.avg_alpha_pct) }}%<br>{% endif %}
    {% else %}
    Win rate се показва след {{ bs.min_closed }} затворени (сега {{ bs.closed }}) — при по-малко е шум.<br>
    {% endif %}
    По режим на деня на картата (записани / затворени{% if bs.stats_visible %}, среден R{% endif %}):
    {% for name, g in bs.by_regime.items() %}{{ name }} {{ g.records }} / {{ g.closed }}{% if bs.stats_visible and g.avg_r is not none %} ({{ "%+.2f"|format(g.avg_r) }}R){% endif %}{{ " · " if not loop.last else "" }}{% endfor %}
    {% endif %}
  </div>
  {{ entry_vol_line(bs.entry_volume) }}
  {{ events_line(bs.events, "R") }}
  {% if bs.live %}
  <div class="small" style="font-size:12px;color:var(--muted);margin-top:14px">Чакащи и отворени ({{ bs.live|length }}):</div>
  <div class="card" style="padding:6px 4px;margin-top:6px">
    <table class="pos-table">
      <thead><tr><th>Тикър</th><th>Карта от</th><th>Статус</th><th class="n">Buy-stop</th><th class="n">Стоп</th><th class="n">Цел 1</th>
        <th>Валиден до</th><th>Режим</th></tr></thead>
      <tbody>
        {% for p in bs.live %}
        <tr><td class="sym">{{ p.ticker }}{% if p.also_action %}{{ markers_html([{"tag": "и Action", "title": "Тикърът е и в Action книгата в застъпващ се период — две независими книги, статистиките не се сумират."}]) }}{% endif %}{{ markers_html(p.markers) }}{{ spinoff_note_html(p) }}</td>
          <td>{{ p.entry_date }}</td>
          <td>{{ bs_st.get(p.status, p.status) }}{% if p.fill_date %} от {{ p.fill_date }}{% endif %}{% if p.current_r is not none %} · {{ "%+.1f"|format(p.current_r) }}R{% endif %}{% if p.entry_volume_ratio is defined and p.entry_volume_ratio is not none %} · обем при входа {{ "%.2f"|format(p.entry_volume_ratio) }}×{% endif %}
            {% if p.screener_exit %}<div style="font-size:11.5px;color:var(--yellow)">излезе от скрийнъра: {{ p.screener_exit }}</div>{% endif %}</td>
          <td class="n">${{ p.buy_stop }}</td><td class="n">${{ p.stop_loss }}</td><td class="n">${{ p.target_1 }}</td>
          <td>{{ p.valid_through or "—" }}</td><td>{{ p.regime or "н/д" }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
  {% if bs.recent %}
  <div class="small" style="font-size:12px;color:var(--muted);margin-top:14px">Последни затворени ({% if bs.closed and bs.closed > bs.recent|length %}последните {{ bs.recent|length }} от {{ bs.closed }}{% else %}{{ bs.recent|length }}{% endif %}):</div>
  <div class="watch-grid" style="margin-top:6px">
    {% for r in bs.recent %}
    <div class="watch-card">
      <span class="ticker" style="color: {{ 'var(--green)' if r.realized_r and r.realized_r > 0 else 'var(--red)' }}">{{ r.ticker }}</span>{% if r.also_action %}{{ markers_html([{"tag": "и Action", "title": "Тикърът е и в Action книгата в застъпващ се период."}]) }}{% endif %}
      <p>{{ r.entry_date }} → {{ r.resolution_date }} · {{ bs_res.get(r.resolution, r.resolution) }} · R={{ r.realized_r }} · {{ r.regime or "н/д" }}</p>
    </div>
    {% endfor %}
  </div>
  {% endif %}
  </details>
</section>
{% endif %}

{# Qullamaggie (07.10.2026): ДВЕ секции след Watchlist (от 19.10 — след сгънатите книги на CANSLIM) и преди GLB — "Пробиви по Kullamägi (Breakout)" и "Епизодични пивоти (EP) · гапове след новина".
   ОТДЕЛНА стратегия (механичен скенер без AI, наблюдение на EP, собствена книга qm_breakout) — не е Action/Watchlist и не пипа размера на позициите ни; QM✓ върху нашите карти води тук #}
{% set qb = backtest.qm_breakout if backtest and backtest.qm_breakout else none %}
{% set our_qm = (action + watchlist)|map(attribute='ticker')|list %}
{% if qm_cards or qm_diag or (qb and qb.enabled) %}
<section id="qm">
  <h2>Пробиви по Kullamägi (Breakout)</h2>
  <div class="qm-banner">
    <b>Измерване, не препоръка. Реплеят е с survivorship (днешният универс) и резултатът зависи от малко големи печалби. Алфата не е статистически значима.</b>
    {% if qm_replay %}Реплей {{ qm_replay.period }} ({{ qm_replay.trades }} сделки), R = печалба ÷ max(вход − дъното на деня, {{ qm_r_floor }}×ADR): среден R {{ "%+.2f"|format(qm_replay.avg_r) }} [{{ "%+.2f"|format(qm_replay.avg_r_ci[0]) }}; {{ "%+.2f"|format(qm_replay.avg_r_ci[1]) }}] (pess {{ "%+.2f"|format(qm_replay.avg_r_pess) }}),
    доходност на сделка средно {{ "%+.2f"|format(qm_replay.avg_return_pct) }}% (медиана {{ "%+.2f"|format(qm_replay.median_return_pct) }}%), алфа спрямо SPY {{ "%+.2f"|format(qm_replay.alpha_pct) }}% [{{ "%+.2f"|format(qm_replay.alpha_ci[0]) }}; {{ "%+.2f"|format(qm_replay.alpha_ci[1]) }}].
    Досегашният среден R ({{ "%+.2f"|format(qm_replay.old_avg_r) }}) беше раздут от сделки с нищожен риск: {{ qm_replay.floored_trades }} сделки носеха {{ qm_replay.floored_share_of_sum_r_pct }}% от ΣR.{% endif %}
    Отделна стратегия, механичен скенер (без AI), независим от CANSLIM скрийнъра, GLB и от Action/Watchlist; не влиза в Action и не променя размера на позициите ни.
    <b>Входът е по opening range high в сесията, стопът — low of day; брифът дава нивата, не самия вход.</b>
  </div>
  {{ corp_excluded_line(corp_excluded.get("qm")) }}
  {% if qm_diag and qm_diag.ok is sameas false %}
  <div class="small" style="font-size:12.5px;color:var(--red)">Скенерът не се изпълни{% if qm_diag.error %} ({{ qm_diag.error }}){% endif %} — празният списък НЕ значи, че няма кандидати за пробив.</div>
  {% else %}
  {% if qm_cards %}
  <div class="qm-grid">
    {% for c in qm_cards %}
    <div class="qm-card{{ ' in-screen' if c.ticker in our_qm else '' }}">
      <div class="qm-top"><span class="qm-sym">{{ c.ticker }}{% if c.ticker in our_qm %}{{ markers_html([{"tag": "QM✓", "title": "Тикърът е и в Action/Watchlist на днешния бриф — QM✓ стои и върху онази карта."}]) }}{% endif %}</span><span class="qm-price">${{ "%.2f"|format(c.close) }}</span></div>
      {% if c.company and c.company != c.ticker %}<div class="qm-company">{{ c.company|cname(34) }}</div>{% endif %}
      {# 22.10.2026 (етап 4): жив запис в книгата qm_breakout — новото ниво не е нов вход (RVTY 22.10) #}
      {% if c.get("book_open") %}<div class="si-flag" title="Книгата не прави втори запис, докато този е отворен.">📈 OPEN — вече отворена в книгата qm_breakout от {{ c.book_open.since[8:10] }}.{{ c.book_open.since[5:7] }}{% if c.book_open.price %} @ ${{ "%.2f"|format(c.book_open.price) }}{% endif %} — новото ниво не е нов вход</div>{% endif %}
      <div class="qm-stat" title="Ниво на пробива = най-високият High на последните {{ qm_trigger_bars }} сесии; +{{ "%.1f"|format(c.pct_to_trigger) }}% над затварянето">Вход над ${{ "%.2f"|format(c.trigger) }} <span class="qm-sm">(+{{ "%.1f"|format(c.pct_to_trigger) }}%)</span>{% if c.dist_adr is defined %} <span class="qm-sm">· до нивото {{ "%.2f"|format(c.dist_adr) }} ADR</span>{% endif %}</div>
      {% if c.earnings_warning %}<div class="earn-warn">{{ c.earnings_warning.text }}</div>{% endif %}
      {% if c.corp_action %}<div class="corp-warn">{{ c.corp_action.text }}</div>{% endif %}
      {% if c.get("spinoff_warning") %}<div class="corp-warn">{{ c.spinoff_warning.text }}</div>{% endif %}{% if c.get("merger_target") %}<div class="corp-warn">{{ c.merger_target.text }}</div>{% endif %}
      {% for n in c.cot_notes or [] %}<div class="cot-note">{{ n.text }}</div>{% endfor %}
      <div class="qm-kv">
        <span>ADR</span><b>{{ "%.1f"|format(c.adr) }}%</b>
        <span>Предходен ръст</span><b>+{{ "%.0f"|format(c.runup_pct) }}%</b>
        <span>Консолидация</span><b title="дълбочина {{ "%.1f"|format(c.depth_pct) }}% · стягане {{ "%.2f"|format(c.tight) }}× ADR · обем {{ "%.2f"|format(c.vol_ratio) }}× от 50-дневния · цена {{ "%+.1f"|format(c.vs_sma10_pct) }}% от 10 MA, {{ "%+.1f"|format(c.vs_sma20_pct) }}% от 20 MA">{{ c.base_days }} дни</b>
      </div>
      {{ levels_block(c.levels, false, false) }}
    </div>
    {% endfor %}
  </div>
  <div class="small" style="font-size:11.5px;color:var(--muted);margin-top:8px">
    {% if qm_diag and qm_diag.with_history %}Подредени по стягане на базата (най-стегнатите първи); лидери: горните {{ ((1 - qm_diag.lead_pct) * 100)|round|int }}% по ръст за 1, 3 и 6 месеца ({{ qm_diag.leaders }} от {{ qm_diag.with_history }} тикъра към
    {{ qm_diag.as_of[8:10] }}.{{ qm_diag.as_of[5:7] }}), кандидати {{ qm_diag.candidates }}{% if qm_diag.candidates > qm_cards|length %}, показани {{ qm_cards|length }}{% endif %}. {% endif %}{% if qm_diag and qm_diag.beyond_adr %}Още {{ qm_diag.beyond_adr }} кандидат(а) са на повече от {{ '%g'|format(qm_max_dist_adr) }}×ADR от нивото ({{ qm_diag.beyond_adr_tickers|join(", ") }}) — не се показват и не се записват. {% endif %}
    Задръж курсора върху консолидацията за подробности (дълбочина на базата, стягане, позиция спрямо 10/20 MA). Стопът за оразмеряване е максималният (1×ADR); реалният стоп е дъното на деня на влизане.
  </div>
  {% else %}
  <div class="small" style="font-size:12.5px;color:var(--muted)">няма кандидати днес{% if qm_diag and qm_diag.with_history %} (проверени {{ qm_diag.with_history }} тикъра){% endif %}{% if qm_diag and qm_diag.beyond_adr %}; още {{ qm_diag.beyond_adr }} са на повече от {{ '%g'|format(qm_max_dist_adr) }}×ADR от нивото ({{ qm_diag.beyond_adr_tickers|join(", ") }}) — не се показват{% endif %}</div>
  {% endif %}
  {% endif %}

  {# ── Измерване: отделната книга qm_breakout (свита; редът над нея казва главното) ── #}
  {% if qb and qb.enabled %}
  <details class="qm-book" style="margin-top:14px">
    <summary style="cursor:pointer;font-size:12.5px;color:var(--muted)">Измерване — книга qm_breakout: записани {{ qb.records }} · затворени {{ qb.closed }}{% if qb.stats_visible %} · win rate {{ qb.win_rate_pct }}%{% else %} · win rate след {{ qb.min_closed }} затворени{% endif %}</summary>
  {% if qb and qb.enabled %}
  {# 12.10.2026: флаг за малък риск на входа — R е раздут от знаменателя (само показване; изчислението на R не е променено) #}
  {% macro qm_tight(p, qb) %}<span style="color:var(--yellow)" title="Рискът на входа (вход − low на входния ден) е {{ "%.2f"|format(p.risk_adr) }}×ADR — под {{ qb.tight_risk_adr }}×ADR. R се смята от пода {{ qb.tight_risk_adr }}×ADR (12.10.2026): с реалния знаменател R би бил раздут — в реплея такива сделки са 12% и носеха 69% от сумата на R.">⚠ риск на входа {{ "%.2f"|format(p.risk_adr) }}×ADR — R от пода {{ qb.tight_risk_adr }}×ADR</span>{% endmacro %}
  {% set qb_res = {"stopped": "стоп", "trailing_stop_exit": "trailing изход", "expired": "изтекла по време"} %}
  {% set qb_st = {"pending": "чака пробива", "open": "отворена", "trailing": "след частична продажба (trailing)"} %}
  <div class="qm-sub">Измерване — книга qm_breakout (отделна от Action и buy-stop)</div>
