      <thead><tr><th>Тримесечие</th><th>EPS факт/оч.</th><th>Изненада</th><th>Реакция</th></tr></thead>
      <tbody>
        {% for q in recap.quarters %}{{ earnings_row(q, false) }}{% endfor %}
        {% if recap.yoy %}{{ earnings_row(recap.yoy, true) }}{% endif %}
      </tbody>
    </table>
    {% if recap.yoy_summary %}
    <p class="earn-yoy-summary">{{ recap.yoy_summary.current_date }} срещу {{ recap.yoy_summary.yoy_date }}
      (тримесечен ръст г/г, не годишен тотал): EPS {{ recap.yoy_summary.eps_current }} vs {{ recap.yoy_summary.eps_yoy }}
      — {{ earnings_pct_cell(recap.yoy_summary.yoy_growth_pct, '') }}</p>
    {% endif %}
    {% if recap.forward %}
    <h3>Следващ отчет</h3>
    <div class="kv"><span>Дата</span><b>{{ recap.forward.next_earnings }} ({{ recap.forward.days_to_earnings }}д)
      {%- if recap.forward.in_blackout %} · blackout{% endif %}</b></div>
    {% if recap.forward.consensus_eps is not none %}
    <div class="kv"><span>Консенсус EPS</span><b>{{ recap.forward.consensus_eps }}
      {%- if recap.forward.expected_growth_pct is not none %} (спрямо {{ recap.forward.yoy_date }}:
      {{ earnings_pct_cell(recap.forward.expected_growth_pct, '') }} очакван г/г ръст){% endif %}</b></div>
    {% endif %}
    {% endif %}
  </div>
</div>
{% endif %}
{% endmacro %}

<section>
  <h2>Action · {{ action|length }} тикъра</h2>
