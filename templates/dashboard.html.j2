      </div>
      <div class="price-tag">${{ st.price }} <span style="color:var(--muted);font-size:13px">pivot ${{ st.pivot }} ({{ st.pct_from_pivot }}%)</span></div>
    </div>
    {% if st.prev_position %}
    <div class="re-entry">↻ Предишна позиция от {{ st.prev_position.entry_date }} приключи на
      {{ st.prev_position.resolution_date }} ({{ st.prev_position.outcome }}{% if st.prev_position.realized_r is not none %},
      {{ "%+.1f"|format(st.prev_position.realized_r) }}R{% endif %}).
