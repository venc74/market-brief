<script>
// ── Исторически календар: отваря docs/archive/<date>.html в iframe ────────
(function () {
  var input = document.getElementById("hist-date");
  var btn = document.getElementById("hist-open");
  var avail = document.getElementById("hist-avail");
  var frame = document.getElementById("history-frame");
  var msg = document.getElementById("history-msg");
  var nav = document.getElementById("hist-nav");
  var prev = document.getElementById("hist-prev");
  var next = document.getElementById("hist-next");
  var cur = document.getElementById("hist-cur");
  if (!input || !btn) return;

  var dates = [];
  fetch("data/index.json", { cache: "no-store" })
    .then(function (r) { return r.ok ? r.json() : []; })
    .then(function (list) {
      dates = Array.isArray(list) ? list.sort() : [];
      if (dates.length) {
        input.min = dates[0];
        input.max = dates[dates.length - 1];
        input.value = dates[dates.length - 1];
        avail.textContent = dates.length + " налични дни (" + dates[0] + " → " + dates[dates.length - 1] + ")";
      } else {
        avail.textContent = "няма архивирани брифове все още";
      }
    })
    .catch(function () { avail.textContent = "архивът е недостъпен"; });

  function open() {
    var d = input.value;
    msg.hidden = true; frame.hidden = true; frame.style.height = "0"; nav.hidden = true;
    if (!d) return;
    if (dates.length && dates.indexOf(d) === -1) {
      msg.hidden = false;
      msg.textContent = "Няма бриф за " + d + " (уикенд, празник или извън архива).";
      return;
    }
    frame.src = "archive/" + d + ".html";
    frame.hidden = false;
    frame.style.height = "1400px";
    var i = dates.indexOf(d);
    if (i !== -1) {
      nav.hidden = false;
      cur.textContent = d.slice(8, 10) + "." + d.slice(5, 7) + "." + d.slice(0, 4);
      prev.disabled = i <= 0;
      next.disabled = i >= dates.length - 1;
    }
  }
  function step(delta) {
    var j = dates.indexOf(input.value) + delta;
    if (j < 0 || j >= dates.length) return;
    input.value = dates[j];
    open();
  }
  btn.addEventListener("click", open);
  prev.addEventListener("click", function () { step(-1); });
  next.addEventListener("click", function () { step(1); });
})();

(function () {
  // Earnings Season Recap модал — НЕ position:fixed, position:absolute с
  // top позициониран спрямо window.scrollY при отваряне (виж CSS коментара).
  function closeAll() {
    document.querySelectorAll(".earn-modal").forEach(function (m) { m.hidden = true; });
  }
  document.querySelectorAll(".earn-icon").forEach(function (icon) {
    icon.addEventListener("click", function () {
      var id = icon.getAttribute("data-modal");
      var modal = document.getElementById(id);
      if (!modal) return;
      closeAll();
      modal.style.top = (window.scrollY || window.pageYOffset || 0) + "px";
      modal.hidden = false;
    });
  });
  document.querySelectorAll(".earn-modal").forEach(function (modal) {
    modal.addEventListener("click", function (e) {
      if (e.target === modal || e.target.closest(".earn-modal-close")) {
        modal.hidden = true;
      }
    });
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") closeAll();
  });
})();
</script>
