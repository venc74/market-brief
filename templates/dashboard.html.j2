{% endmacro %}
{% macro glb_list(kind, label, grp) %}
  <div class="glb-group-label {{ kind }}">{{ label }} GLB ({{ grp.cards|length }})</div>
  <div class="small glb-def">{{ caller() }}</div>
  {% if grp.cards %}
  <div class="wt glb-t">
    <div class="wt-row glb-row wt-head"><span>Тикър</span><span>Над линията</span><span>Сесии</span><span>Месеци без връх</span><span>Обем на пробива</span></div>
    {% for g in grp.cards %}
    <details class="wt-item">
      <summary class="wt-row glb-row">
        <span class="wt-t">{{ g.ticker }}{% if g.in_screener %} <span class="wt-mark">✓ скрийнър</span>{% endif %}{% if g.already_open_position %} <span class="wt-mark">📈 OPEN</span>{% endif %}{% if g.get("corp_action") or g.get("spinoff_warning") or g.get("merger_target") %} <span class="cs-warn">⚠</span>{% endif %}{% if g.company and g.company != g.ticker %}<span class="wt-name">{{ g.company|cname(28) }}</span>{% endif %}</span>
        <span data-l="Над линията" class="wt-num">{% if g.pct_vs_line is number %}{{ "%+.1f"|format(g.pct_vs_line) }}%{% else %}<span class="wt-mu">—</span>{% endif %}</span>
        <span data-l="Сесии" class="wt-num">{% if g.get("sessions") %}{{ g.sessions }} от {{ g.max_sessions }}{% else %}—{% endif %}</span>
        <span data-l="Месеци без връх" class="wt-num">{% if g.months_unpenetrated is defined %}{{ g.months_unpenetrated }} м{% else %}—{% endif %}{% if g.ath_label == 'new_high_since_listing' %} <span class="wt-mu" title="По-кратка налична история — нов връх откакто имаме данни, не потвърден all-time high">· от листването</span>{% endif %}</span>
        <span data-l="Обем на пробива" class="wt-num">{% if g.get("breakout_volume_ratio") is not none %}{{ "%.1f"|format(g.breakout_volume_ratio) }}×{% else %}<span class="wt-mu">н/д</span>{% endif %}</span>
      </summary>
      <div class="wt-detail">{{ glb_card(g) }}</div>
    </details>
    {% endfor %}
  </div>
  {% else %}
  <div class="small" style="font-size:12px;color:var(--muted);margin:0 0 8px">няма {{ label }} кандидати днес</div>
  {% endif %}
  {% if grp.open is not none %}
  <details class="gw-open"><summary>Отворени в книгата — {{ label }} ({{ grp.open|length }})</summary>
    {% if grp.open %}{{ gw_table(grp.open) }}{% else %}<div class="small" style="font-size:12px;color:var(--muted);margin:6px 0">няма отворени записи от този тип</div>{% endif %}
  </details>
  {% endif %}
{% endmacro %}
