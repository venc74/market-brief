      {% if c.track_record and c.track_record.text %}<div class="small" style="font-size:12px;color:var(--muted)">{{ c.track_record.text }}</div>{% endif %}
      {% if c.history_note %}<div class="small" style="font-size:11.5px;color:var(--muted);margin-top:6px">{{ c.history_note }}</div>{% endif %}
      {% if c.thesis_rejected %}
      <div class="small" style="font-size:12px;color:var(--muted);margin-top:8px">
        Тезата е отхвърлена от проверката — {{ c.thesis_rejected }}.
      </div>
      {% endif %}
      {# FIX 2026-09-29: липсваща под-теза (стар JSON без empty_reason) → ред, не нищо #}
      {% if c.direct_thesis %}{{ cot_sub(c.direct_thesis, "Директна теза") }}
