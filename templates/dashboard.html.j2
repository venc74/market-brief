{% set glb_momentum = glb_candidates|selectattr('glb_type', 'equalto', 'momentum')|sort(attribute='months_unpenetrated', reverse=True)|list %}
{% set glb_insufficient = glb_candidates|selectattr('glb_type', 'equalto', 'insufficient_history')|list %}
<section>
  <h2>GLB Watchlist · Green Line Breakout</h2>
  <div class="small" style="font-size:12px;color:var(--muted);margin-bottom:14px">
    ATH пробив след дълъг unpenetrated период (Eric Wish методология) — механичен скрийнър, изцяло извън основния CANSLIM/Weinstein pipeline.
    <b style="color:var(--green)">Classic</b> = тесен daily base преди пробива (по-нисък очакван риск) ·
    <b style="color:var(--yellow)">Momentum</b> = потвърден бърз/волатилен пробив без тесен base (по-висок очакван риск).
  </div>
  {% if glb_classic %}
