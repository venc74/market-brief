{# FIX 2026-09-28 (Release 2): bullish/bearish вече е ЗА ВСЕКИ ТИКЪР, изведен
   от кода от effect (печели/губи от изчисленото движение на инструмента).
   Стар JSON (само th.direction на ниво теза) се рендерира както преди. #}
{% macro cot_sub(th, label) %}
      <div class="cot-sub">
        {% set per_ticker = th.tickers and (th.tickers|selectattr('effect', 'defined')|list) %}
        <div class="cot-sub-label">{{ label }}
          {% if th.tickers and not per_ticker and th.direction %}<span class="cot-direction {{ th.direction }}">{{ th.direction }}</span>{% endif %}
        </div>
        {% if th.tickers %}
        <div class="cot-tickers">{% for t in th.tickers %}{{ t.ticker }} ({{ t.company|cname }}){{ markers_html(t.markers) }}{% if t.partial %} <span class="small" style="color:var(--muted)" title="Частична експозиция: компанията е преработвател/диверсифицирана — инструментът е само една част от бизнеса ѝ">~частична</span>{% endif %}{% if per_ticker %}{% if t.conflict %} <span class="cot-direction conflict" title="Моделът дава противоположен ефект за същия тикър в другата под-теза на този пазар">⚠ противоречие</span>{% elif t.direction %} <span class="cot-direction {{ t.direction }}" title="{{ 'печели' if t.effect == 'gains' else 'губи' }} от очакваното движение">{{ t.direction }}</span>{% endif %}{% endif %}{{ "  ·  " if not loop.last else "" }}{% endfor %}</div>
        {% endif %}
        {# пакет 3: cross-sector — изречението с посоката е шаблон от кода, прозата на модела описва само механизма #}
        {% for t in th.tickers or [] %}{% if t.sentence %}<div class="thesis-chain">{{ t.sentence }}{% if t.quote %} <span class="small" style="color:var(--muted)">{{ t|cot_quote }}</span>{% endif %}</div>{% endif %}{% endfor %}
        {# 08.10: обратен залог (подбран тикър срещу обратния ефект на тезата) и обратни сигнали между COT пазари — бележки от кода #}
        {% for t in th.tickers or [] %}{% for o in t.opposite or [] %}<div class="opp-note">{{ o.text }}</div>{% endfor %}{% for x in t.cross_market or [] %}<div class="opp-note">{{ x }}</div>{% endfor %}{% endfor %}
        {% if th.reasoning %}<div class="thesis-chain">{{ th.reasoning }}</div>{% endif %}
        {% if th.empty_reason %}
        <div class="small" style="font-size:12px;color:var(--muted);margin-top:4px">
          Няма {{ label|lower }} — {{ th.empty_reason }}.
        </div>
        {% endif %}
        {% if th.stale_note %}
        <div class="small" style="font-size:11.5px;color:var(--yellow);margin-top:4px">⚠ {{ th.stale_note }}</div>
        {% endif %}
        {% if th.withdrawn_tickers %}
        <div class="small" style="font-size:11px;color:var(--muted);margin-top:4px">
          Няма пряка връзка — {{ th.withdrawn_tickers|join(', ') }} махнат(и) от списъка.
        </div>
        {% endif %}
        {% if th.outside_screener %}
        <div class="small" style="font-size:11px;color:var(--muted);margin-top:4px">
          Тези тикъри не са в текущия CANSLIM скрийнър.
        </div>
        {% endif %}
        {# 08.10: празна теза носи списъка на изключените в самата причина ("Няма … — всички предложени тикъри бяха изключени …") — вторият ред "Изключени:" би го повторил; еднаквите причини са на един ред #}
        {% if th.dropped_tickers and (th.tickers or not th.empty_reason) %}
        <div class="small" style="font-size:11px;color:var(--muted);margin-top:4px">
          Изключени: {% for g in th.dropped_tickers|group_dropped %}{{ g.tickers|join(", ") }}{% if g.reason %} — {{ g.reason }}{% else %} (премахнат при верификация){% endif %}{{ "; " if not loop.last else "." }}{% endfor %}
        </div>
        {% endif %}
      </div>
{% endmacro %}

{% if cot or (cot_status and cot_status.stale) %}
<section>
