        {% if st.eps_growth_yoy is defined and st.eps_growth_yoy is not none %}<div class="kv"><span title="earningsQuarterlyGrowth на Yahoo: нетната печалба на последното тримесечие срещу година по-рано — не е EPS от отчета">Ръст на нетната печалба (Yahoo, тримесечие г/г)</span><b>{{ "%+.1f"|format(st.eps_growth_yoy) }}%</b></div>{% endif %}
        <div class="kv"><span>Revenue ръст YoY</span><b>{{ st.revenue_growth_yoy }}%</b></div>
        <div class="kv"><span>ROE</span><b>{{ st.roe }}%</b></div>
