      <div class="glb-stat">{{ g.months_unpenetrated }} месеца unpenetrated</div>
      {% if g.get("rule") == "wish_high" %}<div class="glb-detail">линия (High) ${{ "%.2f"|format(g.line) }} ({{ g.prior_high_month[5:7] }}.{{ g.prior_high_month[:4] }})</div>
      {% else %}<div class="glb-detail">prior high ${{ "%.2f"|format(g.prior_high) }} ({{ g.prior_high_month }})</div>{% endif %}
      {# пакет 4б т.е: събитието (линия + дата на входа) е в data/glb_state.json — оцелява при смяна на месеца #}
      {# 26.10.2026 (етап 4б, т. 10): датата на СЕСИЯТА на пробива (since_bar), не на брифа — NWSA и ED на 23.10 бяха „GLB от 23.10“ при пробив на 22.10 (старият хистерезис) #}
      {% set g_day = g.since_bar or g.since %}{% if g.since %}<div class="glb-detail"><b>GLB от {{ g_day[8:10] }}.{{ g_day[5:7] }}</b>{% if g.get("sessions") %} · сесия {{ g.sessions }} от {{ g.max_sessions }}{% endif %}, {{ "%.1f"|format(g.pct_vs_line|abs) }}% {{ 'над' if g.pct_vs_line >= 0 else 'под' }} линията (${{ "%.2f"|format(g.line) }})</div>{% endif %}
      {# 21.10.2026 (етап 4): линията на Уиш — High на месечния бар към деня на входа; само информация #}
      {% set wl = g.get("wish_high") %}{% if wl %}<div class="glb-detail" title="Уиш чертае зелената линия при най-високата цена (High) на месечния бар, непробита поне {{ glb_min_months }} месеца; нашата е по месечния close. Към деня на нашия вход. Само информация.">
        {%- if wl.valid %}линия по Уиш (High): ${{ "%.2f"|format(wl.line) }} ({{ wl.month[5:7] }}.{{ wl.month[:4] }}) — {{ 'над' if wl.pct >= 0 else 'под' }} нея с {{ "%.1f"|format(wl.pct|abs) }}%
        {%- else %}по Уиш (High): при входа няма зелена линия — върхът ${{ "%.2f"|format(wl.line) }} ({{ wl.month[5:7] }}.{{ wl.month[:4] }}) е непробит {{ wl.months_unpen }} мес. (нужни ≥ {{ glb_min_months }}); цената е {{ "%.1f"|format(wl.pct|abs) }}% {{ 'над' if wl.pct >= 0 else 'под' }} него{% endif %}</div>{% endif %}
      {% if g.get("closes_below_line") is not none %}<div class="glb-detail" title="Хистерезисът държи картата до −3% под линията; по правилото на Уиш първото затваряне под линията е изход.">затваряния под линията от входа: {{ g.closes_below_line }}{% if g.closes_below_line %} — по правилото на Уиш първото е изход{% endif %}</div>{% endif %}
      {% if g.tightness %}
      <div class="glb-detail">band_hold {{ g.tightness.band_hold_pct }}% · диапазон на {{ glb_days }} дни {{ g.tightness.tightness_range_pct }}% от линията</div>
      {% endif %}
      {# 09.10: информативни полета — не филтрират (виж config.GLB_VOLUME_AVG_BARS) #}
      <div class="glb-detail" title="Обем на деня на пробива ÷ средния обем на предишните {{ glb_vol_bars }} бара; цена ÷ най-ниското Low за 52 седмици. Само информация.">обем на пробива {% if g.get("breakout_volume_ratio") is not none %}{{ "%.1f"|format(g.get("breakout_volume_ratio")) }}× средния{% else %}н/д{% endif %} · {% if g.get("x_from_52w_low") is not none %}{{ "%.1f"|format(g.get("x_from_52w_low")) }}× от 52-седм. дъно{% else %}дъно н/д{% endif %}</div>
      {% if g.ath_label == 'new_high_since_listing' %}
      <div class="glb-caveat">⚠ по-кратка налична история — "нов връх откакто имаме данни", не потвърден буквален all-time high</div>
      {% endif %}
      {% if g.get("corp_action") %}<div class="corp-warn">{{ g.corp_action.text }}</div>{% endif %}
      {% if g.get("spinoff_warning") %}<div class="corp-warn">{{ g.spinoff_warning.text }}</div>{% endif %}{% if g.get("merger_target") %}<div class="corp-warn">{{ g.merger_target.text }}</div>{% endif %}
      <div class="glb-note">{{ g.risk_note }}</div>
      {% if g.in_screener %}<div class="si-flag">✓ и в нашия скрийнър — конвергенция</div>{% endif %}
      {% if g.already_open_position %}<div class="si-flag">📈 OPEN — вече отворена Track Record позиция</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div class="glb-group-label momentum">Momentum GLB (0)</div>
  <div class="small" style="font-size:12px;color:var(--muted);margin:0 0 12px">няма Momentum кандидати днес</div>
  {% endif %}
  {% if glb_insufficient %}
  <div class="glb-insufficient-note">
    Недостатъчна дневна история за tightness оценка (валиден месечен GLB сигнал, но некласифициран Classic/Momentum):
    {{ glb_insufficient|map(attribute='ticker')|join(', ') }}
  </div>
  {% endif %}
</section>
{% elif glb_status %}
{# С3 (10.10.2026): празният списък — провал или наистина няма кандидати; до 10.10 секцията изчезваше и двете изглеждаха еднакво #}
<section>
  <h2>GLB Watchlist · Green Line Breakout</h2>
  {% if glb_status.ok is sameas false %}
  <div class="small" style="font-size:12.5px;color:var(--yellow)">⚠ Скрийнърът не се изпълни днес ({{ glb_status.error or "Yahoo не върна данни" }}) — празният списък НЕ значи, че няма GLB кандидати.</div>
  {% else %}
  <div class="small" style="font-size:12.5px;color:var(--muted)">Няма GLB кандидати днес — проверени {{ glb_status.with_history }} от {{ glb_status.universe }} тикъра{% if glb_status.batches_failed %} ({{ glb_status.batches_failed }} партиди не се изтеглиха){% endif %}.</div>
  {% endif %}
  {{ corp_excluded_line(corp_excluded.get("glb")) }}
</section>
