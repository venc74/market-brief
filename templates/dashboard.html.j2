{% macro split_chip(s) %}
    <div class="signal-chip {{ 'in-screen' if s.ticker in our_tickers else '' }} {{ 'split-pos' if s.badge == 'position' else '' }}">
      <div class="sym">{{ s.ticker }}
        {% if s.split_type == 'reverse' %}<span class="split-tag rev">reverse</span>
        {% elif s.split_type == 'normal' %}<span class="split-tag fwd">normal</span>{% endif %}
      </div>
      <div class="note">
        {% if s.ratio %}<b>{{ s.ratio }}</b>{% endif %}
        {% if s.price %} · ${{ "%.2f"|format(s.price) }}{% endif %}
        {% if s.date_human %} · {{ s.date_human }}{% endif %}
      </div>
      {% if s.company %}<div class="note" style="color:var(--muted);font-size:12px">{{ s.company[:34] }}</div>{% endif %}
      {% if s.badge %}
      {% set d = s.days_to_split %}
      <div class="split-badge">{{ '📌 отворена позиция' if s.badge == 'position' else '🔎 наблюдаван' }}{% if d is not none %} · {% if d == 0 %}днес{% elif d == 1 %}утре{% elif d > 1 %}след {{ d }} дни{% else %}преди {{ -d }} {{ 'ден' if d == -1 else 'дни' }}{% endif %}{% endif %}</div>
      {% endif %}
      {% if s.ticker in our_tickers %}<div class="in-screen">✓ и в нашия скрийнър</div>{% endif %}
    </div>
{% endmacro %}

{% if splits_report %}
{% set sr = splits_report %}
{% set dg = sr.diag or {} %}
